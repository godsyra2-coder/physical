		  particle={ col=Color3.fromRGB(200,240,255), rate=16 } },

		{ name="Obsidian",sp=1.5,  w=0.46, fem=3.8, tib=5.0, reach=7.2, bh=3.7, sw=0.44, lift=1.9, grate=0.08, gbob=0.14,
		  ang={38,70,110,142,-38,-70,-110,-142},
		  bmat=Enum.Material.Slate, lmat=Enum.Material.Slate, col=Color3.fromRGB(14,14,18), refl=0.05, trans=0, acc=Color3.fromRGB(255,60,60),
		  bsz=Vector3.new(4.8,1.6,5.8), hsz=Vector3.new(3.2,1.9,3.6), spikes=true },

		{ name="Solar",   sp=1.45, w=0.42, fem=3.9, tib=5.1, reach=7.4, bh=3.7, sw=0.42, lift=1.9, grate=0.1, gbob=0.11,
		  ang={34,66,114,146,-34,-66,-114,-146},
		  bmat=Enum.Material.Metal, lmat=Enum.Material.DiamondPlate, col=Color3.fromRGB(60,40,20), refl=0.2, trans=0, acc=Color3.fromRGB(255,150,40),
		  bsz=Vector3.new(4.6,1.5,5.6), hsz=Vector3.new(3.0,1.8,3.4),
		  particle={ col=Color3.fromRGB(255,150,40), rate=26 } },

		{ name="MaxMech", sp=1.7,  w=0.5,  fem=3.9, tib=5.2, reach=7.6, bh=4.2, sw=0.46, lift=1.7, grate=0.06, gbob=0.18,
