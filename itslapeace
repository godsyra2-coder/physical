	{ "Point", "point" }, { "Dance", "dance" }, { "Dance 2", "dance2" }, { "Dance 3", "dance3" },
	{ "Laugh", "laugh" }, { "Cheer", "cheer" }, { "Stop", "stop" }, { "Mirror", "__mirror" },
	{ "Sword", "__sword" }, { "Swing", "__swing" }, { "Skin: Classic", "__skin" },
}

for i, b in ipairs(BUTTONS) do
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.fromOffset(82, 26)
	btn.LayoutOrder = i
	btn.BackgroundColor3 = Color3.fromRGB(46, 46, 56)
	btn.BorderSizePixel = 0
	btn.Text = b[1]
	btn.TextColor3 = Color3.fromRGB(230, 230, 235)
	btn.Font = Enum.Font.Gotham
	btn.TextSize = 12
	btn.Parent = scroll
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
	if b[2] == "__mirror" then mirrorBtn = btn end
	if b[2] == "__sword" then swordBtn = btn end
	btn.MouseButton1Click:Connect(function()
		if b[2] == "__mirror" then
			if piloting then return end
			setMirror(mode ~= "mirror")
			btn.BackgroundColor3 = (mode == "mirror") and Color3.fromRGB(70, 140, 90) or Color3.fromRGB(46, 46, 56)
		elseif b[2] == "__sword" then
			setSword(not swordOn)
		elseif b[2] == "__swing" then
			swordSwing()
		elseif b[2] == "__skin" then
			applySkin(skinIdx + 1)
			btn.Text = "Skin: " .. SKINS[skinIdx].name
		else
			playCat(b[2])
		end
	end)
end

