local function makeSlider(order, cfg)
	-- cfg = { name, def, min, max, log, fmt, apply }
	local S = { min = cfg.min, max = cfg.max, def = cfg.def, value = cfg.def, log = cfg.log }
	local fmt = cfg.fmt or "%.2f"

	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -10, 0, 48);  row.LayoutOrder = order
	row.BackgroundColor3 = Color3.fromRGB(30, 30, 38);  row.BorderSizePixel = 0
	row.ZIndex = 9;  row.Parent = sliderPanel
	Instance.new("UICorner", row).CornerRadius = UDim.new(0, 5)

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -52, 0, 14);  lbl.Position = UDim2.fromOffset(6, 3)
	lbl.BackgroundTransparency = 1;  lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.TextColor3 = Color3.fromRGB(210, 210, 218);  lbl.Font = Enum.Font.Gotham;  lbl.TextSize = 11
	lbl.ZIndex = 10;  lbl.Parent = row

	local rst = Instance.new("TextButton")
	rst.Size = UDim2.fromOffset(40, 14);  rst.Position = UDim2.new(1, -44, 0, 3)
	rst.BackgroundColor3 = Color3.fromRGB(52, 52, 64);  rst.BorderSizePixel = 0
	rst.Text = "reset";  rst.TextColor3 = Color3.fromRGB(210, 210, 218)
	rst.Font = Enum.Font.Gotham;  rst.TextSize = 10;  rst.ZIndex = 10;  rst.Parent = row
	Instance.new("UICorner", rst).CornerRadius = UDim.new(0, 3)

	local track = Instance.new("Frame")
	track.Size = UDim2.new(1, -16, 0, 6);  track.Position = UDim2.fromOffset(8, 22)
	track.BackgroundColor3 = Color3.fromRGB(58, 58, 70);  track.BorderSizePixel = 0
	track.ZIndex = 10;  track.Parent = row
	Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.fromOffset(12, 15);  knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.BackgroundColor3 = Color3.fromRGB(212, 212, 222);  knob.BorderSizePixel = 0
	knob.ZIndex = 11;  knob.Parent = track
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

	local function mkbox(x, txt)
		local b = Instance.new("TextBox")
		b.Size = UDim2.fromOffset(42, 14);  b.Position = x
		b.BackgroundColor3 = Color3.fromRGB(44, 44, 54);  b.BorderSizePixel = 0
		b.Text = txt;  b.TextColor3 = Color3.fromRGB(200, 200, 210)
		b.Font = Enum.Font.Gotham;  b.TextSize = 10;  b.ClearTextOnFocus = false
		b.ZIndex = 10;  b.Parent = row
		Instance.new("UICorner", b).CornerRadius = UDim.new(0, 3)
		return b
	end
	local minBox = mkbox(UDim2.fromOffset(8, 31), tostring(cfg.min))
	local maxBox = mkbox(UDim2.new(1, -46, 0, 31), tostring(cfg.max))

	local function relOf(v)
		if S.log and S.min > 0 and S.max > 0 then return math.log(v / S.min) / math.log(S.max / S.min) end
		return (v - S.min) / (S.max - S.min)
	end
	local function valOf(rel)
		if S.log and S.min > 0 and S.max > 0 then return S.min * (S.max / S.min) ^ rel end
		return S.min + (S.max - S.min) * rel
	end
	function S:refresh()
		local rel = math.clamp(relOf(self.value), 0, 1)
		knob.Position = UDim2.new(rel, 0, 0.5, 0)
		lbl.Text = cfg.name .. ": " .. string.format(fmt, self.value)
	end
	function S:setValue(v, skipApply)
		self.value = math.clamp(v, math.min(S.min, S.max), math.max(S.min, S.max))
		self:refresh()
		if not skipApply and cfg.apply then cfg.apply(self.value) end
	end
	function S:dragTo(px)
		local rel = math.clamp((px - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		self:setValue(valOf(rel))
	end
	local function beginDrag(io)
		if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then
			activeSlider = S;  S:dragTo(io.Position.X)
		end
	end
	track.InputBegan:Connect(beginDrag)
	knob.InputBegan:Connect(beginDrag)
	rst.MouseButton1Click:Connect(function() S:setValue(S.def) end)
	local function commitRange()
		local lo, hi = tonumber(minBox.Text), tonumber(maxBox.Text)
		if lo and hi and hi > lo then
			S.min, S.max = lo, hi
			minBox.Text, maxBox.Text = tostring(lo), tostring(hi)
			S:setValue(S.value, true)
		else
			minBox.Text, maxBox.Text = tostring(S.min), tostring(S.max)
		end
	end
	minBox.FocusLost:Connect(commitRange)
	maxBox.FocusLost:Connect(commitRange)

	S:setValue(cfg.def, true)
	return S
end

