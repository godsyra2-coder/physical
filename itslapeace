		if not alive or not spiderOn then return end
		acc += dt;  if acc < 1 / SRATE then return end;  acc = 0
		local mv, ms = {}, {}
		for _, m in ipairs(SMIRROR) do
			mv[#mv + 1] = { Part = m.sp, CFrame = m.lp.CFrame }
			ms[#ms + 1] = { Part = m.sp, Scale = m.lp.Size * MESH_SCALE }
			m.sp.LocalTransparencyModifier = 1;  m.sp.CastShadow = false
		end
		for i = 1, #mv, CHUNK do
			local a, b = {}, {}
			for j = i, math.min(i + CHUNK - 1, #mv) do a[#a + 1] = mv[j];  b[#b + 1] = ms[j] end
			task.spawn(function() pcall(invoke, ep, "SyncMove", a) end)
