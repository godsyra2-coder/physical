	--// full server mirror: every visible local spider part gets a 0.001 twin, streamed each tick.
	local SRATE   = 26          -- server update Hz (drop if it strains the server)
	local SMIRROR = {}          -- { { sp = serverPart, lp = localPart } }
	local spiderPushLook       -- (re)sends per-part colour/material/transparency to the server
	local cf0 = CFrame.new(0, -400, 0)
	local CHUNK = 40   -- F3X calls may cap entries; chunk big batches
	local function batched(action, entries, extra)
		for i = 1, #entries, CHUNK do
			local c = {}
			for j = i, math.min(i + CHUNK - 1, #entries) do c[#c + 1] = entries[j] end
			if extra ~= nil then pcall(invoke, ep, action, c, extra) else pcall(invoke, ep, action, c) end
			task.wait()
		end
	end
	local mirrorList = { body, hull, core, under, eye, mand1, mand2, abdo }
	for _, k in ipairs(spikes) do mirrorList[#mirrorList + 1] = k end
	for _, l in ipairs(legs) do
		for _, nm in ipairs({ "coxa","femur","tibia","tip","jHip","jKnee",
		                      "mBarrel","mRod","mHipBox","mKneeBox","mPlate","mHipRing","mKneeRing" }) do
			mirrorList[#mirrorList + 1] = l[nm]
		end
	end

	--// build all twins: create in parallel, then claim + configure in BATCHES (few remote calls, not ~1000)
	task.spawn(function()
		local made, qi, done = {}, 0, 0
		local function worker()
			while true do
				qi += 1;  local idx = qi
				local lp = mirrorList[idx]
				if not lp then done += 1;  return end
				local ball = (lp.Shape == Enum.PartType.Ball)
				local p = ep:InvokeServer("CreatePart", ball and "Ball" or "Normal", cf0, workspace)
				if p then made[idx] = { p = p, lp = lp, ball = ball } end
			end
		end
		for _ = 1, 8 do task.spawn(worker) end
		repeat task.wait(0.1) until done >= 8

		local list = {}
		for idx = 1, #mirrorList do if made[idx] then list[#list + 1] = made[idx].p end end
		if #list == 0 then return end
		for i = 1, #list, 30 do                                -- claim in chunks
			local chunk = {}
			for j = i, math.min(i + 29, #list) do chunk[#chunk + 1] = list[j] end
			EscalateEvent:FireServer(PartOwnership, chunk)
			task.wait(0.06)
		end
		local t0 = os.clock()
		repeat task.wait(0.1) until (list[#list]:FindFirstChild("RRPartOwner")) or os.clock() - t0 > 12

		local resize, names, cmesh, brick, sphere, matB = {}, {}, {}, {}, {}, {}
		for idx = 1, #mirrorList do
			local e = made[idx]
			if e and e.p:FindFirstChild("RRPartOwner") then
				SMIRROR[#SMIRROR + 1] = { sp = e.p, lp = e.lp }
				spiderServer[#spiderServer + 1] = e.p
				names[#names + 1] = e.p
				resize[#resize + 1] = { Part = e.p, Size = Vector3.new(MICRO, MICRO, MICRO), CFrame = cf0 }
				cmesh[#cmesh + 1]  = { Part = e.p }
				local entry = { Part = e.p, MeshType = e.ball and Enum.MeshType.Sphere or Enum.MeshType.Brick, Scale = e.lp.Size * MESH_SCALE }
				if e.ball then sphere[#sphere + 1] = entry else brick[#brick + 1] = entry end
				matB[#matB + 1] = { Part = e.p, Material = e.lp.Material, Transparency = e.lp.Transparency }
			end
		end
		local coll, anch = {}, {}
		for _, m in ipairs(SMIRROR) do
			coll[#coll + 1] = { Part = m.sp, CanCollide = false }
			anch[#anch + 1] = { Part = m.sp, Anchored = true }
		end
		batched("SyncResize", resize)
		batched("SetName", names, "Sp")
		batched("SyncCollision", coll)
		batched("CreateMeshes", cmesh)
		batched("SyncMesh", brick)
		batched("SyncMesh", sphere)
		batched("SyncMaterial", matB)
		batched("SyncAnchor", anch)
		for _, m in ipairs(SMIRROR) do castShadowOff(m.sp);  m.sp.CanQuery = false end
		if spiderPushLook then spiderPushLook() end
		print("[spider] server mirror:", #SMIRROR, "/", #mirrorList)
	end)

