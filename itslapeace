local SENDS_PER_TICK = 1          -- fire-and-forget SyncMove calls per tick. sent on BOTH Stepped and
                                 -- Heartbeat = 2 samples/frame. >1 just duplicates data (congestion).

--// ---------- idle-mode target CFrame ----------
local lastCF = CFrame.new(0, 5, 0)
local function getTargetCF()
	if typeof(_G.R6Rig_Target) == "CFrame" then lastCF = _G.R6Rig_Target; return lastCF end
	local r = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	if r then lastCF = r.CFrame * CFrame.new(4, 0, 0) end
	return lastCF
end

local parkCF     -- set when PILOT turns off: rig stays exactly where you left it
local curScale = 1
local swordOn = false
local localSword                                                       -- pooled sword part (client side)
--// Right Arm -> sword: position (studs, arm-local) then rotation. tune live with _G.R6Rig_SwordGrip
local swordGripCF = CFrame.new(0, -1, -1.4) * CFrame.Angles(math.rad(-180), 0, math.rad(90))
local setSword, swordSwing        -- defined after the replicator (need `invoke`)
local function baseCF()
	if typeof(_G.R6Rig_Target) == "CFrame" then return _G.R6Rig_Target end
	return parkCF or getTargetCF()
end
_G.R6Rig_Follow = function() parkCF = nil end   -- resume following you

