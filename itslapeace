	if sp then moveList[#moveList + 1] = { sp = sp, lp = localParts[s.name], body = true, head = (s.name == "Head") } end
end

--// ---------- animation ----------
local mode = "anim"      -- "anim" | "mirror"
local piloting = false
local pilotEmote = false  -- an emote is playing during pilot; suspends the walk/idle state machine
local spyLevel = 0        -- 0 off | 1 hide tesseract | 2 also ghost the body 50%
local tessHidden = false
local setSpy              -- defined after the sword/tesseract are built
local mobileJumpGui       -- touch JUMP button (the native one hides when we zero the real char's jump)
local spiderOn = false
local setSpider           -- swap the R6 rig for a procedural spider (defined after everything is built)
local spiderRecolor       -- recolour spider neon accents to the current skin
local spiderServer = {}   -- server-side spider parts, for cleanup
local currentTrack, autoState
local trackCache = {}

local function resolveAnimId(cat)
	local animate = plr.Character and plr.Character:FindFirstChild("Animate")
	if animate then
		local folder = animate:FindFirstChild(cat)
		if folder then
			for _, ch in ipairs(folder:GetChildren()) do
				if ch:IsA("Animation") and ch.AnimationId ~= "" then return ch.AnimationId end
			end
		end
	end
	return FALLBACK[cat] or FALLBACK.idle
end

--// sword anims outrank everything else. hold pose (toolnone) is a persistent overlay
--// at Action2 so it owns the arms over walk/idle; swings punch through at Action4.
local PRIORITY = {
	toolslash = Enum.AnimationPriority.Action4,
	toollunge = Enum.AnimationPriority.Action4,
}

local function stopTrack()
	if currentTrack then currentTrack:Stop(0.15); currentTrack = nil end
end

local function playCore(cat)
	stopTrack()
	if cat == "stop" then return end
	local tr = trackCache[cat]
	if not tr then
		local a = Instance.new("Animation")
		a.AnimationId = resolveAnimId(cat)
		local ok, res = pcall(function() return animator:LoadAnimation(a) end)
		if not ok then warn("[rig] load failed:", cat, res); return end
		tr = res;  trackCache[cat] = tr
	end
	if PRIORITY[cat] then tr.Priority = PRIORITY[cat] end
	tr.Looped = not ONESHOT[cat]
	tr:Play(0.12)
	currentTrack = tr
end

local function autoAnim(cat)          -- pilot: state-driven
	if autoState == cat then return end
	autoState = cat
	playCore(cat)
end

local function setMirror(on)
	if on then
		mode = "mirror"; stopTrack()
		for _, s in ipairs(RIG) do localParts[s.name].Anchored = true end
	else
		mode = "anim"
		for _, s in ipairs(RIG) do
			localParts[s.name].Anchored = (s.name == "HumanoidRootPart")
		end
	end
end

local function playCat(cat)            -- GUI emote button (works while piloting too)
	if mode == "mirror" then setMirror(false); if mirrorBtn then end end
	autoState = nil
	playCore(cat)
	if piloting then
		pilotEmote = (cat ~= "stop")
		if pilotEmote and ONESHOT[cat] then                 -- wave/point/laugh/jump: auto-resume after it ends
			local L = (currentTrack and currentTrack.Length) or 0
			if L <= 0 then L = 1.2 end
			task.delay(L, function() pilotEmote = false end)
		end
	end
end

--// ---------- PILOT ----------
local savedWS, savedJP, savedJH
local function setPilot(on)
	if on == piloting then return end
	piloting = on
	local realHum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")

	if on then
		if mode == "mirror" then setMirror(false) end
		autoState = nil;  pilotEmote = false
		hum.PlatformStand = false
		localParts.HumanoidRootPart.Anchored = false
		localParts["Left Leg"].CanCollide = true
		localParts["Right Leg"].CanCollide = true
		localParts.HumanoidRootPart.CFrame = localParts.HumanoidRootPart.CFrame + Vector3.new(0, 2, 0)
		cam.CameraSubject = hum
		if realHum then
			savedWS, savedJP, savedJH = realHum.WalkSpeed, realHum.JumpPower, realHum.JumpHeight
			realHum.WalkSpeed, realHum.JumpPower, realHum.JumpHeight = 0, 0, 0
		end
	else
		if swordOn and setSword then setSword(false) end
		local hrp = localParts.HumanoidRootPart
		local pos, lv = hrp.Position, hrp.CFrame.LookVector
		local flat = Vector3.new(lv.X, 0, lv.Z)
		if flat.Magnitude < 1e-3 then flat = Vector3.new(0, 0, -1) end
		parkCF = CFrame.lookAt(pos, pos + flat)   -- freeze exactly here, upright (never snaps back to you)
		hum:Move(Vector3.zero)
		hum.PlatformStand = true
		hrp.Anchored = true
		localParts["Left Leg"].CanCollide = false
		localParts["Right Leg"].CanCollide = false
		if realHum then
			cam.CameraSubject = realHum
			realHum.WalkSpeed = savedWS or 16
			realHum.JumpPower = savedJP or 0
			realHum.JumpHeight = savedJH or 7.2
		end
		autoState = nil;  pilotEmote = false
		playCore("idle")
	end
	if pilotBtn then
		pilotBtn.BackgroundColor3 = on and Color3.fromRGB(190, 95, 60) or Color3.fromRGB(46, 46, 56)
		pilotBtn.Text = on and "PILOT: ON  (Esc-btn to stop)" or "PILOT"
	end
	if mobileJumpGui then mobileJumpGui.Enabled = on end
end
_G.R6Rig_Pilot = setPilot

UIS.JumpRequest:Connect(function()
