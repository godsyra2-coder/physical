--// ---------- SPIDER MODE - mechanical 8-leg walker (3-segment IK legs, tetrapod gait) ----------
--// the invisible HumanoidRootPart does the moving; the body rides it; legs plant + step in a wave.
do
	local NLEG   = 8
	local PHASE  = { 0, 0.5, 0.5, 0, 0.5, 0, 0, 0.5 }    -- tetrapod: diagonal legs anti-phase
	local GUN, DKR = Color3.fromRGB(32, 35, 43), Color3.fromRGB(19, 21, 27)
	local function glow() return SKINS[skinIdx].glow or Color3.fromRGB(90, 210, 255) end

	--// live config — Special Skins overwrite these
	local CFG = {
		SP = 1.4, W = 0.42, FEMUR = 3.8, TIBIA = 5.0, REACH = 7.2, BODY_H = 3.6,
		HIP_R = 2.0, HIP_UP = 0.2, SHO_OUT = 1.9, SHO_UP = 2.1,
		SWING = 0.42, LIFT = 1.9, LEAD = 0.16, GRATE = 0.09, GBOB = 0.12,
		ANG = { 34, 66, 114, 146, -34, -66, -114, -146 },
	}

	local rigM = Instance.new("Model");  rigM.Name = "Spider";  rigM.Parent = localModel
	local accents = {}
	local function mk(mat, col, ball, isAccent)
		local p = Instance.new("Part")
		p.Size = Vector3.one;  p.Material = mat;  p.Color = col
		p.Anchored = true;  p.CanCollide = false;  p.CanQuery = false;  p.CanTouch = false
		p.Massless = true;  p.CastShadow = false;  p.Transparency = 1
		if ball then p.Shape = Enum.PartType.Ball end
		p.Parent = rigM
		if isAccent then accents[#accents + 1] = p end
		return p
	end

	--// body cluster
	local body  = mk(Enum.Material.DiamondPlate, GUN)
	local hull  = mk(Enum.Material.Metal, GUN, true)
	local core  = mk(Enum.Material.Neon, glow(), false, true)
	local under = mk(Enum.Material.Neon, glow(), false, true)
	local eye   = mk(Enum.Material.Neon, glow(), true, true)
	local mand1 = mk(Enum.Material.Metal, DKR)
	local mand2 = mk(Enum.Material.Metal, DKR)
	local abdo  = mk(Enum.Material.SmoothPlastic, DKR, true)   -- rear abdomen bulb (some SSkins)
	local spikes = {};  for s = 1, 8 do spikes[s] = mk(Enum.Material.Metal, DKR) end

	--// signature particle on the body
	local pAtt = Instance.new("Attachment");  pAtt.Parent = body
	local particle = Instance.new("ParticleEmitter")
	particle.Enabled = false;  particle.Rate = 22;  particle.Lifetime = NumberRange.new(0.5, 1.2)
	particle.Speed = NumberRange.new(1, 3);  particle.SpreadAngle = Vector2.new(45, 45)
	particle.LightEmission = 0.85
	particle.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 0) })
	particle.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 1) })
	particle.Parent = pAtt

	--// legs (sized/coloured by applySSkin). k* parts are the Klann linkage (Max Mechanical SSkin only)
	local legs = {}
	for i = 1, NLEG do
		legs[i] = {
			out = Vector3.zero, hipL = Vector3.zero, shoL = Vector3.zero,
			anchor = Vector3.zero, foot = Vector3.zero, swingFrom = nil, planted = true, swingTo = nil,
			coxa  = mk(Enum.Material.Metal, GUN),
			femur = mk(Enum.Material.DiamondPlate, GUN),
			tibia = mk(Enum.Material.Metal, GUN),
			tip   = mk(Enum.Material.Neon, glow(), false, true),
			jHip  = mk(Enum.Material.Neon, glow(), true, true),
			jKnee = mk(Enum.Material.Neon, glow(), true, true),
			mBarrel = mk(Enum.Material.Metal, GUN),        mRod  = mk(Enum.Material.Metal, GUN),
			mHipBox = mk(Enum.Material.DiamondPlate, GUN), mKneeBox = mk(Enum.Material.DiamondPlate, GUN),
			mPlate  = mk(Enum.Material.DiamondPlate, GUN), mHipRing = mk(Enum.Material.Neon, glow(), false, true),
			mKneeRing = mk(Enum.Material.Neon, glow(), false, true),
		}
	end

	local function seg(part, a, b, thick)
		local d = b - a
		local len = math.max(d.Magnitude, 0.05)
		local up = math.abs(d.Unit.Y) > 0.99 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
		part.Size = Vector3.new(thick, thick, len)
		part.CFrame = CFrame.lookAt((a + b) * 0.5, b, up)
	end

	--// place a box so its local Z axis spans a->b
	local function bar(part, a, b, tx, ty)
		local d = b - a
		local len = math.max(d.Magnitude, 0.02)
		local up = math.abs(d.Unit.Y) > 0.99 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
		part.Size = Vector3.new(tx, ty or tx, len)
		part.CFrame = CFrame.lookAt((a + b) * 0.5, b, up)
	end
	local function ik(root, target, l1, l2, pole)
		local toT = target - root
		if toT.Magnitude < 1e-3 then return root + Vector3.new(0, -l1, 0) end
		local dist = math.clamp(toT.Magnitude, math.abs(l1 - l2) + 0.05, l1 + l2 - 0.05)
		local dir = toT.Unit
		local cosA = math.clamp((l1*l1 + dist*dist - l2*l2) / (2 * l1 * dist), -1, 1)
		local right = dir:Cross(pole)
		if right.Magnitude < 1e-3 then right = dir:Cross(Vector3.new(0, 1, 0)) end
		right = right.Unit
		local up = right:Cross(dir).Unit
		return root + (dir * cosA + up * math.sqrt(math.max(0, 1 - cosA*cosA))) * l1
	end

	local rp = RaycastParams.new();  rp.FilterType = Enum.RaycastFilterType.Exclude
	local function cast(o, d)
		local ex = { localModel, plr.Character }
		for _, p in ipairs(spiderServer) do ex[#ex + 1] = p end
		for _, p in pairs(serverParts) do ex[#ex + 1] = p end
		if swordBlade then ex[#ex + 1] = swordBlade end
		if tessParts then for _, e in ipairs(tessParts) do if e.sp then ex[#ex + 1] = e.sp end end end
		rp.FilterDescendantsInstances = ex
		return workspace:Raycast(o, d, rp)
	end

	--// wall climbing state
	local climbing, surfN, spos = false, Vector3.new(0, 1, 0), nil
	local jumpReq = false
	UIS.JumpRequest:Connect(function()
		if spiderOn and climbing and not UIS:GetFocusedTextBox() then jumpReq = true end
	end)

	local gait, lastP, bob = 0, nil, 0
	local function frame(dt)
		if not spiderOn then
			if climbing then climbing = false;  hum.PlatformStand = false end
			return
		end
		local SP     = CFG.SP
		local W      = CFG.W * SP
		local FEMUR  = CFG.FEMUR * SP
		local TIBIA  = CFG.TIBIA * SP
		local REACH  = CFG.REACH * SP
		local BODY_H = CFG.BODY_H * SP
		local SWING  = CFG.SWING
		local LIFT   = CFG.LIFT * SP
		local LEAD   = CFG.LEAD
		local WALL_SEEK, CLIMB_SPD = 4.5 * SP, 17 * SP
		local hrp = localParts.HumanoidRootPart
		local mv = (playerControls and playerControls:GetMoveVector()) or Vector3.new()
		local inMag = Vector3.new(mv.X, 0, mv.Z).Magnitude
		local look = hrp.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		flat = (flat.Magnitude < 1e-3) and Vector3.new(0, 0, -1) or flat.Unit
		local gy = hrp.Position.Y - 3

		--// ---------- surface / climb ----------
		if climbing and not piloting then climbing = false;  hum.PlatformStand = false end
		if not climbing then
			spos = Vector3.new(hrp.Position.X, gy + BODY_H, hrp.Position.Z)
			surfN = surfN:Lerp(Vector3.new(0, 1, 0), math.min(dt * 6, 1))
			local h = piloting and cast(spos, flat * WALL_SEEK)
			if h and math.abs(h.Normal.Y) < 0.5 and inMag > 0.15 then      -- wall ahead + pushing into it
				climbing, surfN = true, h.Normal
				spos = h.Position + h.Normal * BODY_H
				hum.PlatformStand = true
			end
		end
		if climbing then
			local probe = cast(spos + surfN * 2, -surfN * (BODY_H + 7))
			if probe and math.abs(probe.Normal.Y) < 0.9 then
				surfN = surfN:Lerp(probe.Normal, math.min(dt * 9, 1)).Unit
				spos = probe.Position + surfN * BODY_H
			else                                                          -- ran off the wall
				climbing = false;  hum.PlatformStand = false
				hrp.CFrame = CFrame.new(spos + Vector3.new(0, 0.6, 0))
			end
		end
		if climbing then
			local wUp = Vector3.new(0, 1, 0) - surfN * surfN.Y
			if wUp.Magnitude < 0.08 then wUp = flat - surfN * flat:Dot(surfN) end   -- ceiling: use facing
			wUp = wUp.Unit
			local wRight = surfN:Cross(wUp).Unit
			if jumpReq then
				jumpReq, climbing = false, false
				hum.PlatformStand = false
				hrp.CFrame = CFrame.new(spos + surfN * 1.5)
				hrp.AssemblyLinearVelocity = surfN * 26 + Vector3.new(0, 34, 0)
			else
				spos += (wUp * -mv.Z + wRight * mv.X) * CLIMB_SPD * dt
				local re = cast(spos + surfN * (BODY_H + 2), -surfN * (BODY_H + 9))
				if re then spos = re.Position + surfN * BODY_H end
				hrp.CFrame = CFrame.new(spos)
				hrp.AssemblyLinearVelocity = Vector3.zero
			end
		end

		--// ---------- body ----------
		if not lastP then lastP = spos end
		local vel = (spos - lastP) / math.max(dt, 1e-3);  lastP = spos
		local tang = vel - surfN * vel:Dot(surfN)
		local speed = tang.Magnitude
		local faceDir = flat
		if climbing then
			faceDir = (speed > 0.4) and tang.Unit or (Vector3.new(0, 1, 0) - surfN * surfN.Y)
			if faceDir.Magnitude < 0.05 then faceDir = flat - surfN * flat:Dot(surfN) end
			faceDir = faceDir.Unit
		end
		local baseCF = CFrame.lookAt(spos, spos + faceDir, surfN)

		gait = (gait + dt * (0.5 + math.min(speed, 40) * CFG.GRATE)) % 1
		bob += (math.sin(gait * math.pi * 4) * (CFG.GBOB*SP + math.min(speed, 20) * 0.012*SP) - bob) * math.min(dt * 12, 1)
		local pitch = math.clamp(-speed * 0.012, -0.16, 0)
		local roll  = math.clamp(-vel:Dot(baseCF.RightVector) * 0.007, -0.16, 0.16)
		local bodyCF = baseCF * CFrame.new(0, bob, 0) * CFrame.Angles(pitch, 0, roll)
		local down = -bodyCF.UpVector

		body.CFrame  = bodyCF
		hull.CFrame  = bodyCF * CFrame.new(0, 0.55*SP, 0.4*SP)
		core.CFrame  = bodyCF * CFrame.new(0, 1.0*SP, -0.2*SP)
		under.CFrame = bodyCF * CFrame.new(0, -0.85*SP, 0)
		eye.CFrame   = bodyCF * CFrame.new(0, 0.15*SP, -2.9*SP)
		mand1.CFrame = bodyCF * CFrame.new(-0.5*SP, -0.2*SP, -2.6*SP) * CFrame.Angles(math.rad(-18), math.rad(14), 0)
		mand2.CFrame = bodyCF * CFrame.new( 0.5*SP, -0.2*SP, -2.6*SP) * CFrame.Angles(math.rad(-18), math.rad(-14), 0)
		abdo.CFrame  = bodyCF * CFrame.new(0, 0.25*SP, 3.4*SP)
		for s = 1, 8 do
			local ang = (s - 0.5) / 8 * math.pi * 2
			local p = (bodyCF * Vector3.new(math.sin(ang) * 1.5*SP, 0.7*SP, math.cos(ang) * 1.8*SP))
			spikes[s].CFrame = CFrame.lookAt(p, p + (p - bodyCF.Position) + bodyCF.UpVector * 2*SP)
		end

		local mech = CFG.mech
		for i, l in ipairs(legs) do
			local hip = bodyCF * l.hipL
			local sho = bodyCF * l.shoL
			local outW = bodyCF:VectorToWorldSpace(l.out)

			local restPt = sho + outW * (REACH * 0.55) + tang * LEAD
			local h = cast(restPt - down * 5, down * (BODY_H + 12))
			local ideal = h and h.Position or (restPt + down * BODY_H)

			if l.anchor == Vector3.zero then l.anchor, l.foot = ideal, ideal end
			local ph = (gait + PHASE[i]) % 1
			if ph < SWING then
				local t = ph / SWING
				if l.planted then l.swingFrom, l.planted = l.foot, false end
				l.swingTo = ideal
				local e = t * t * (3 - 2 * t)
				l.foot = l.swingFrom:Lerp(l.swingTo, e) - down * (math.sin(t * math.pi) * LIFT)
			else
				if not l.planted then l.anchor, l.planted = l.foot, true end
				l.foot = l.anchor
			end

			local knee = ik(sho, l.foot, FEMUR, TIBIA, outW + bodyCF.UpVector * 0.6)
			seg(l.coxa, hip, sho, W * 1.4)
			seg(l.femur, sho, knee, W)
			seg(l.tibia, knee, l.foot, W * 0.82)
			local fd = l.foot - knee
			fd = (fd.Magnitude < 1e-3) and down or fd.Unit
			local fup = math.abs(fd:Dot(bodyCF.RightVector)) > 0.99 and bodyCF.UpVector or bodyCF.RightVector
			l.tip.CFrame   = CFrame.lookAt(l.foot + fd * 0.5*SP, l.foot + fd * 2, fup)
			l.jHip.CFrame  = CFrame.new(sho)
			l.jKnee.CFrame = CFrame.new(knee)

			if mech then
				--// ---- Max Mechanical dress-up: hydraulic piston + servos + plates ----
				local pA = sho:Lerp(knee, 0.16) + fup * (W * 1.1)   -- barrel mount on the femur
				local pB = knee:Lerp(l.foot, 0.52)                  -- rod mount on the tibia
				local axis = pB - pA
				local aL = math.max(axis.Magnitude, 0.2)
				local aD = axis / aL
				local barLen = math.min(aL * 0.6, FEMUR * 0.55)
				bar(l.mBarrel, pA, pA + aD * barLen, W * 1.05)
				bar(l.mRod,    pA + aD * (barLen - 0.15), pB, W * 0.55)
				bar(l.mPlate,  sho:Lerp(knee, 0.35), sho:Lerp(knee, 0.75), W * 2.4, W * 0.5)
				bar(l.mHipBox,  sho:Lerp(knee, -0.14), sho:Lerp(knee, 0.16), W * 2.0)
				bar(l.mKneeBox, knee:Lerp(l.foot, -0.12), knee:Lerp(l.foot, 0.14), W * 1.7)
				local function ringCF(at, toward)
					local d = toward - at
					d = (d.Magnitude < 1e-3) and Vector3.yAxis or d.Unit
					local u = (math.abs(d.Y) > 0.99) and Vector3.xAxis or Vector3.yAxis
					return CFrame.lookAt(at, at + d, u)
				end
				l.mHipRing.Size,  l.mHipRing.CFrame  = Vector3.new(W*2.6, W*2.6, W*0.5), ringCF(sho, knee)
				l.mKneeRing.Size, l.mKneeRing.CFrame = Vector3.new(W*2.1, W*2.1, W*0.5), ringCF(knee, l.foot)
			end
		end
	end
	RunService.RenderStepped:Connect(function(dt) if alive then frame(dt) end end)

	--// server: body + femur + tibia per leg. IK keeps segments a fixed length -> SyncMove only.
	local sBody
	local sSeg = {}
	local function claim(p)
		EscalateEvent:FireServer(PartOwnership, { [1] = p })
		local t0 = os.clock()
		repeat task.wait(0.01) until p:FindFirstChild("RRPartOwner") or os.clock() - t0 > 5
		return p:FindFirstChild("RRPartOwner") ~= nil
	end
	local function mkServer(name, scale)
		local cf = CFrame.new(0, -500, 0)
		local p = ep:InvokeServer("CreatePart", "Normal", cf, workspace)
		if not (p and claim(p)) then return nil end
		ep:InvokeServer("SyncResize",    { [1] = { Part = p, Size = Vector3.new(MICRO, MICRO, MICRO), CFrame = cf } })
		ep:InvokeServer("SetName",       { p }, name)
		ep:InvokeServer("SyncColor",     { [1] = { Part = p, Color = GUN } })
		ep:InvokeServer("SyncCollision", { [1] = { Part = p, CanCollide = false } })
		ep:InvokeServer("CreateMeshes",  { [1] = { Part = p } })
		ep:InvokeServer("SyncMesh",      { [1] = { Part = p, MeshType = Enum.MeshType.Brick, Scale = scale } })
		ep:InvokeServer("SyncMaterial",  { [1] = { Part = p, Material = Enum.Material.Metal, Transparency = 1 } })
		ep:InvokeServer("SyncAnchor",    { [1] = { Part = p, Anchored = true } })
		castShadowOff(p)
		p.CanQuery = false
		spiderServer[#spiderServer + 1] = p
		return p
	end
	task.spawn(function()
		local sp = CFG.SP
		sBody = mkServer("SpiderBody", Vector3.new(4.6*sp*MESH_SCALE, 1.5*sp*MESH_SCALE, 5.6*sp*MESH_SCALE))
	end)
	for i = 1, NLEG do
		task.spawn(function()
			local sp = CFG.SP
			local fw = CFG.W * sp * MESH_SCALE
			local f = mkServer("SpiderLeg", Vector3.new(fw, fw, CFG.FEMUR * sp * MESH_SCALE))
			local t = mkServer("SpiderLeg", Vector3.new(fw * 0.82, fw * 0.82, CFG.TIBIA * sp * MESH_SCALE))
			if f then sSeg[#sSeg + 1] = { part = f, i = i, k = "f" } end
			if t then sSeg[#sSeg + 1] = { part = t, i = i, k = "t" } end
		end)
		task.wait(0.03)
	end

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		if not alive or not spiderOn then return end
		acc += dt;  if acc < 1 / 30 then return end;  acc = 0
		local mv = {}
		if sBody then mv[#mv + 1] = { Part = sBody, CFrame = body.CFrame };  sBody.LocalTransparencyModifier = 1;  sBody.CastShadow = false end
		for _, s in ipairs(sSeg) do
			local part = (s.k == "f") and legs[s.i].femur or legs[s.i].tibia
			mv[#mv + 1] = { Part = s.part, CFrame = part.CFrame }
			s.part.LocalTransparencyModifier = 1;  s.part.CastShadow = false
		end
		if #mv > 0 then task.spawn(function() pcall(invoke, ep, "SyncMove", mv) end) end
	end)

	--// ---- Special Skins: not just colours — proportions, gait, materials, decorations ----
	local SSKINS = {
		{ name="Recon",   sp=1.4,  w=0.42, fem=3.8, tib=5.0, reach=7.2, bh=3.6, sw=0.42, lift=1.9, grate=0.09, gbob=0.12,
		  ang={34,66,114,146,-34,-66,-114,-146},
		  bmat=Enum.Material.DiamondPlate, lmat=Enum.Material.Metal, col=GUN, refl=0, trans=0, acc=nil,
