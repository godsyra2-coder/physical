local CAST_TOKEN = "PAhcHfXvb2sNMKoxt4y4betUjELnMfCf4G5DRHruMSAkAm6Bgx"
local function castShadowOff(p)
	if not PropertyChanged then return end
	pcall(function() PropertyChanged:FireServer(p, "CastShadow", false) end)
	pcall(function() PropertyChanged:FireServer(p, "CastShadow", false, CAST_TOKEN) end)
end

