--// ---------- tunables ----------
local MICRO      = 0.001          -- server parts shrunk to 0.001x, restored visually by a BlockMesh
local MESH_SCALE = 1 / MICRO      -- => 1000  (tiny part + 1000 block mesh = looks normal, hard to grief)
local HEAD_MESH       = "rbxasset://fonts/head.mesh"
local HEAD_MESH_SCALE = 1                 -- FileMesh scale is absolute (not part-relative)
local BODY_MESH = {                       -- FileMesh per body part (right limbs / left limbs / torso)
	["Right Arm"] = "rbxassetid://488154808", ["Right Leg"] = "rbxassetid://488154808",
	["Left Arm"]  = "rbxassetid://488154609", ["Left Leg"]  = "rbxassetid://488154609",
	["Torso"]     = "rbxassetid://489667862",
}
local BODY_MESH_SCALE = 0.01              -- absolute; tune if the meshes come out the wrong size
local SENDS_PER_TICK = 1          -- fire-and-forget SyncMove calls per tick. sent on BOTH Stepped and
                                 -- Heartbeat = 2 samples/frame. >1 just duplicates data (congestion).

--// ---------- idle-mode target CFrame ----------
local lastCF = CFrame.new(0, 5, 0)
local function getTargetCF()
	if typeof(_G.R6Rig_Target) == "CFrame" then lastCF = _G.R6Rig_Target; return lastCF end
	local r = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	if r then lastCF = r.CFrame * CFrame.new(4, 0, 0) end
	return lastCF
end

local parkCF     -- set when PILOT turns off: rig stays exactly where you left it
local curScale = 1
local swordOn = false
local localSword                                                       -- pooled sword part (client side)
--// Right Arm -> sword: position (studs, arm-local) then rotation. tune live with _G.R6Rig_SwordGrip
local swordGripCF = CFrame.new(0, -1, -1.4) * CFrame.Angles(math.rad(-180), 0, math.rad(90))
local setSword, swordSwing        -- defined after the replicator (need `invoke`)
local function baseCF()
	if typeof(_G.R6Rig_Target) == "CFrame" then return _G.R6Rig_Target end
	return parkCF or getTargetCF()
end
_G.R6Rig_Follow = function() parkCF = nil end   -- resume following you

--// ---------- LOCAL rig ----------
local localModel = Instance.new("Model")
localModel.Name = "LocalR6Rig"
localModel.Parent = workspace

local localParts = {}
for _, s in ipairs(RIG) do
	local p = Instance.new("Part")
	p.Name = s.name;  p.Size = s.size;  p.Color = s.color
	p.Material = Enum.Material.Plastic
	p.Transparency = s.transparency or 0
	p.Anchored = (s.name == "HumanoidRootPart")
	p.CastShadow = false
	p.CanCollide = false;  p.CanQuery = false;  p.CanTouch = false;  p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth;  p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = localModel
	localParts[s.name] = p
end
localModel.PrimaryPart = localParts.HumanoidRootPart
localParts.HumanoidRootPart.CFrame = getTargetCF()

do  --// local rig gets the same meshes as the server copy
	local hm = Instance.new("SpecialMesh")
	hm.MeshType = Enum.MeshType.FileMesh
	hm.MeshId   = HEAD_MESH
	hm.Scale    = Vector3.new(HEAD_MESH_SCALE, HEAD_MESH_SCALE, HEAD_MESH_SCALE)
	hm.Parent   = localParts.Head
	for name, id in pairs(BODY_MESH) do
		local bm = Instance.new("SpecialMesh")
		bm.MeshType = Enum.MeshType.FileMesh
		bm.MeshId   = id
		bm.Scale    = Vector3.new(BODY_MESH_SCALE, BODY_MESH_SCALE, BODY_MESH_SCALE)
		bm.Parent   = localParts[name]
	end
end

local motorRec = {}
for _, m in ipairs(MOTORS) do
	local mot = Instance.new("Motor6D")
	mot.Name = m.name
	mot.Part0 = localParts[m.p0];  mot.Part1 = localParts[m.p1]
	mot.C0 = m.c0;  mot.C1 = m.c1
	mot.Parent = localParts[m.parent]
	motorRec[#motorRec + 1] = { inst = mot, c0 = m.c0, c1 = m.c1 }
end

local hum = Instance.new("Humanoid")
hum.RigType = Enum.HumanoidRigType.R6
hum.BreakJointsOnDeath = false
hum.RequiresNeck = false
hum.MaxHealth = math.huge
hum.Health = math.huge
hum.PlatformStand = true          -- idle mode: no walking/falling
hum.Parent = localModel

local animator = Instance.new("Animator")
animator.Parent = hum

--// ---------- SERVER rig ----------
local serverParts = {}
do
	local done = 0
	for _, s in ipairs(RIG) do
		task.spawn(function()
			if s.name ~= "HumanoidRootPart" then   -- HRP is invisible + non-colliding: no server part needed
				local cf = getTargetCF() * s.offset
				local part = ep:InvokeServer("CreatePart", "Normal", cf, workspace)
				if part then
					EscalateEvent:FireServer(PartOwnership, { [1] = part })
					local t0 = os.clock()
					repeat task.wait(0.01) until part:FindFirstChild("RRPartOwner") or (os.clock() - t0) > 5
					if part:FindFirstChild("RRPartOwner") then
						ep:InvokeServer("SyncResize",    { [1] = { Part = part, Size = s.size * MICRO, CFrame = cf } })
						ep:InvokeServer("SetName",       { part }, s.name)
						ep:InvokeServer("SyncColor",     { [1] = { Part = part, Color = s.color } })
						ep:InvokeServer("SyncMaterial",  { [1] = { Part = part, Material = Enum.Material.Plastic, Transparency = s.transparency or 0 } })
						ep:InvokeServer("SyncCollision", { [1] = { Part = part, CanCollide = false } })
						ep:InvokeServer("CreateMeshes",  { [1] = { Part = part } })
						--// FileMesh Scale is ABSOLUTE (not part-relative like BlockMesh) — no 1/MICRO multiplier.
						local meshId = (s.name == "Head") and HEAD_MESH or BODY_MESH[s.name]
						local ms = (s.name == "Head") and HEAD_MESH_SCALE or BODY_MESH_SCALE
						if meshId then
							ep:InvokeServer("SyncMesh", { [1] = { Part = part, MeshType = Enum.MeshType.FileMesh,
								MeshId = meshId, Scale = Vector3.new(ms, ms, ms) } })
						else
							ep:InvokeServer("SyncMesh", { [1] = { Part = part, MeshType = Enum.MeshType.Brick,
								Scale = Vector3.new(MESH_SCALE, MESH_SCALE, MESH_SCALE) } })
						end
						ep:InvokeServer("SyncAnchor",    { [1] = { Part = part, Anchored = true } })
						if PropertyChanged then
							pcall(function() PropertyChanged:FireServer(part, "CastShadow", false) end)  -- ⚠ signature guessed: (part, prop, value)
						end
						serverParts[s.name] = part
					end
				end
			end
			done += 1
		end)
		task.wait(0.0001)
	end
	repeat task.wait() until done >= #RIG
	local all = {}
	for _, s in ipairs(RIG) do if serverParts[s.name] then all[#all + 1] = serverParts[s.name] end end
	if #all > 0 then
		local m = ep:InvokeServer("CreateGroup", "Model", workspace, all)
		if m then ep:InvokeServer("SetName", { m }, "R6Rig") end
	end
	print("[rig] server rig:", #all, "/", #RIG - 1)
end

--// flat pair list (built once) so the replicator does no lookups / no allocation per loop
local moveList = {}
for _, s in ipairs(RIG) do
	local sp = serverParts[s.name]
	if sp then moveList[#moveList + 1] = { sp = sp, lp = localParts[s.name], body = true, head = (s.name == "Head") } end
end

--// ---------- animation ----------
local mode = "anim"      -- "anim" | "mirror"
local piloting = false
local currentTrack, autoState
local trackCache = {}

local function resolveAnimId(cat)
	local animate = plr.Character and plr.Character:FindFirstChild("Animate")
	if animate then
		local folder = animate:FindFirstChild(cat)
		if folder then
			for _, ch in ipairs(folder:GetChildren()) do
				if ch:IsA("Animation") and ch.AnimationId ~= "" then return ch.AnimationId end
			end
		end
	end
	return FALLBACK[cat] or FALLBACK.idle
end

--// sword anims outrank everything else. hold pose (toolnone) is a persistent overlay
--// at Action2 so it owns the arms over walk/idle; swings punch through at Action4.
local PRIORITY = {
	toolslash = Enum.AnimationPriority.Action4,
	toollunge = Enum.AnimationPriority.Action4,
}

local function stopTrack()
	if currentTrack then currentTrack:Stop(0.15); currentTrack = nil end
end

local function playCore(cat)
	stopTrack()
	if cat == "stop" then return end
	local tr = trackCache[cat]
	if not tr then
		local a = Instance.new("Animation")
		a.AnimationId = resolveAnimId(cat)
		local ok, res = pcall(function() return animator:LoadAnimation(a) end)
		if not ok then warn("[rig] load failed:", cat, res); return end
		tr = res;  trackCache[cat] = tr
	end
	if PRIORITY[cat] then tr.Priority = PRIORITY[cat] end
	tr.Looped = not ONESHOT[cat]
	tr:Play(0.12)
	currentTrack = tr
end

local function autoAnim(cat)          -- pilot: state-driven
	if autoState == cat then return end
	autoState = cat
	playCore(cat)
end

local function setMirror(on)
	if on then
		mode = "mirror"; stopTrack()
		for _, s in ipairs(RIG) do localParts[s.name].Anchored = true end
	else
		mode = "anim"
		for _, s in ipairs(RIG) do
			localParts[s.name].Anchored = (s.name == "HumanoidRootPart")
		end
	end
end

local function playCat(cat)            -- GUI emote button
	if piloting then return end
	if mode == "mirror" then setMirror(false); if mirrorBtn then end end
	autoState = nil
	playCore(cat)
end

--// ---------- PILOT ----------
local savedWS, savedJP, savedJH
local function setPilot(on)
	if on == piloting then return end
	piloting = on
	local realHum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")

	if on then
		if mode == "mirror" then setMirror(false) end
		autoState = nil
		hum.PlatformStand = false
		localParts.HumanoidRootPart.Anchored = false
		localParts["Left Leg"].CanCollide = true
		localParts["Right Leg"].CanCollide = true
		localParts.HumanoidRootPart.CFrame = localParts.HumanoidRootPart.CFrame + Vector3.new(0, 2, 0)
		cam.CameraSubject = hum
		if realHum then
			savedWS, savedJP, savedJH = realHum.WalkSpeed, realHum.JumpPower, realHum.JumpHeight
			realHum.WalkSpeed, realHum.JumpPower, realHum.JumpHeight = 0, 0, 0
		end
	else
		if swordOn and setSword then setSword(false) end
		local hrp = localParts.HumanoidRootPart
		local pos, lv = hrp.Position, hrp.CFrame.LookVector
		local flat = Vector3.new(lv.X, 0, lv.Z)
		if flat.Magnitude < 1e-3 then flat = Vector3.new(0, 0, -1) end
		parkCF = CFrame.lookAt(pos, pos + flat)   -- freeze exactly here, upright (never snaps back to you)
		hum:Move(Vector3.zero)
		hum.PlatformStand = true
		hrp.Anchored = true
		localParts["Left Leg"].CanCollide = false
		localParts["Right Leg"].CanCollide = false
		if realHum then
			cam.CameraSubject = realHum
			realHum.WalkSpeed = savedWS or 16
			realHum.JumpPower = savedJP or 0
			realHum.JumpHeight = savedJH or 7.2
		end
		autoState = nil
		playCore("idle")
	end
	if pilotBtn then
		pilotBtn.BackgroundColor3 = on and Color3.fromRGB(190, 95, 60) or Color3.fromRGB(46, 46, 56)
		pilotBtn.Text = on and "PILOT: ON  (Esc-btn to stop)" or "PILOT"
	end
end
_G.R6Rig_Pilot = setPilot

UIS.JumpRequest:Connect(function()
	if piloting and not UIS:GetFocusedTextBox() then hum.Jump = true end
end)
hum.Died:Connect(function()
	if piloting then setPilot(false) end
end)

--// ---------- per-frame ----------
local alive = true
RunService.RenderStepped:Connect(function()
	if not alive then return end

	if piloting then
		local typing = UIS:GetFocusedTextBox() ~= nil   -- chat / textbox open -> don't drive the rig
		local dir = Vector3.zero
		if not typing then
			if playerControls then
				dir = playerControls:GetMoveVector()                          -- native input: keyboard + thumbstick + gamepad
			else                                                             -- fallback: raw WASD, camera-relative
				if UIS:IsKeyDown(Enum.KeyCode.W) then dir += Vector3.new(0, 0, -1) end
				if UIS:IsKeyDown(Enum.KeyCode.S) then dir += Vector3.new(0, 0,  1) end
				if UIS:IsKeyDown(Enum.KeyCode.A) then dir += Vector3.new(-1, 0, 0) end
				if UIS:IsKeyDown(Enum.KeyCode.D) then dir += Vector3.new( 1, 0, 0) end
			end
		end
		dir = Vector3.new(dir.X, 0, dir.Z)
		if dir.Magnitude > 1 then dir = dir.Unit end                          -- clamp; analog stick pushes stay partial

		local running = not typing and (
			UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.RightShift)
			or (not UIS.KeyboardEnabled and dir.Magnitude > 0.9)   -- touch: full stick = run
		)
		hum.WalkSpeed = running and 24 or 16
		hum:Move(dir, true)   -- true = relative to camera (matches GetMoveVector's space)

		local st = hum:GetState()
		if st == Enum.HumanoidStateType.Jumping then
			autoAnim("jump")
		elseif st == Enum.HumanoidStateType.Freefall then
			autoAnim("fall")
		elseif st == Enum.HumanoidStateType.Climbing then
			autoAnim("climb")
		elseif hum.MoveDirection.Magnitude > 0.05 then
			autoAnim(running and "run" or "walk")
			if currentTrack then currentTrack:AdjustSpeed(hum.WalkSpeed / 16) end
		else
			autoAnim("idle")   -- toolnone is a separate persistent overlay (holdTrack), not a state
		end
	else
		local base = baseCF() * CFrame.new(0, 3 * (curScale - 1), 0)   -- lift so bigger rigs keep feet on ground
		localParts.HumanoidRootPart.CFrame = base
		if mode == "mirror" then
			local char = plr.Character
			local chrp = char and char:FindFirstChild("HumanoidRootPart")
			if chrp then
				for rigName, cands in pairs(MIRROR_MAP) do
					local cp
					for _, n in ipairs(cands) do cp = char:FindFirstChild(n); if cp then break end end
					if cp then localParts[rigName].CFrame = base * (chrp.CFrame:Inverse() * cp.CFrame) end
				end
			end
		end
	end

	for i = 1, #moveList do
		local sp = moveList[i].sp
		sp.LocalTransparencyModifier = 1        -- hide server copy (incl. sword) from yourself
		sp.CastShadow = false                   -- and never render its shadow locally
	end
end)

--// sword follows the Right Arm AFTER the animation pose is applied, so grip pos+rot always land
RunService:BindToRenderStep("R6RigSword", Enum.RenderPriority.Character.Value + 1, function()
	if alive and localSword then
		local g = swordGripCF
		local grip = (g - g.Position) + g.Position * curScale   -- keep rotation, scale the offset with the rig
		localSword.CFrame = localParts["Right Arm"].CFrame * grip
	end
end)

--// ---------- movement replicator: fire-and-forget, changed-parts-only ----------
--// never wait on a reply. only send a part whose pose actually moved since last send,
--// so idle limbs don't hog the pipe and the parts that DO move get through sooner.
--// sent on Stepped and Heartbeat both -> 2 fresh samples per rendered frame.
local invoke = ep.InvokeServer
local function fire(b) pcall(invoke, ep, "SyncMove", b) end

do
	local last = {}
	local function push()
		if not alive then return end
		local batch
		for i = 1, #moveList do   -- live length: the sword blade is appended later
			local cf = moveList[i].lp.CFrame
			local p = last[i]
			if (not p) or (cf.Position - p.Position).Magnitude > 0.02
			   or cf.LookVector:Dot(p.LookVector) < 0.9997 then
				last[i] = cf
				batch = batch or {}
				batch[#batch + 1] = { Part = moveList[i].sp, CFrame = cf }
			end
		end
		if batch then
			for _ = 1, SENDS_PER_TICK do task.spawn(fire, batch) end
		end
	end
	RunService.Stepped:Connect(push)
	RunService.Heartbeat:Connect(push)
end

--// ---------- noob size (scales local skeleton + server BlockMesh) ----------
local SCALE_MIN, SCALE_MAX = 0.1, 12
local SCALE_MID = math.log(1 / SCALE_MIN) / math.log(SCALE_MAX / SCALE_MIN)   -- knob fraction where k = 1x
local function scalePos(cf, k)
	local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
	return CFrame.new(x * k, y * k, z * k, r00, r01, r02, r10, r11, r12, r20, r21, r22)
end
local meshStamp = 0
local function setScale(k)
	curScale = k
	for _, s in ipairs(RIG) do localParts[s.name].Size = s.size * k end           -- local skeleton, live
	for _, r in ipairs(motorRec) do
		r.inst.C0 = scalePos(r.c0, k)
		r.inst.C1 = scalePos(r.c1, k)
	end
	if localSword then                                                            -- sword scales with the rig
		local sm = localSword:FindFirstChildOfClass("SpecialMesh")
		if sm then sm.Scale = Vector3.new(k, k, k) end
	end
	for _, s in ipairs(RIG) do                                                    -- local head + body meshes
		local m = localParts[s.name]:FindFirstChildOfClass("SpecialMesh")
		if m then
			local ms = (s.name == "Head") and HEAD_MESH_SCALE or BODY_MESH_SCALE
			m.Scale = Vector3.new(ms * k, ms * k, ms * k)
		end
	end
	local stamp = os.clock()
	meshStamp = stamp
	task.delay(0.05, function()                                                   -- server meshes, debounced
		if meshStamp ~= stamp then return end
		local headS, bodyS = HEAD_MESH_SCALE * k, BODY_MESH_SCALE * k
