			if freecamOn and io.UserInputType == Enum.UserInputType.MouseMovement then
				fcYaw   -= io.Delta.X * 0.0028
				fcPitch = math.clamp(fcPitch - io.Delta.Y * 0.0028, -math.rad(85), math.rad(85))
			end
		end)
		fcConn = RunService.RenderStepped:Connect(function(dt)
			local rot = CFrame.Angles(0, fcYaw, 0) * CFrame.Angles(fcPitch, 0, 0)
			local mv = Vector3.new()
			if not UIS:GetFocusedTextBox() then
				if UIS:IsKeyDown(Enum.KeyCode.W) then mv += Vector3.new(0, 0, -1) end
				if UIS:IsKeyDown(Enum.KeyCode.S) then mv += Vector3.new(0, 0,  1) end
				if UIS:IsKeyDown(Enum.KeyCode.A) then mv += Vector3.new(-1, 0, 0) end
				if UIS:IsKeyDown(Enum.KeyCode.D) then mv += Vector3.new( 1, 0, 0) end
				if UIS:IsKeyDown(Enum.KeyCode.E) or UIS:IsKeyDown(Enum.KeyCode.Space) then mv += Vector3.new(0, 1, 0) end
				if UIS:IsKeyDown(Enum.KeyCode.Q) or UIS:IsKeyDown(Enum.KeyCode.LeftControl) then mv += Vector3.new(0, -1, 0) end
			end
			if mv.Magnitude > 0 then mv = mv.Unit end
			local boost = UIS:IsKeyDown(Enum.KeyCode.LeftShift) and 3 or 1
			fcPos += (rot * mv) * fcSpeed * boost * dt
			cam.CFrame = CFrame.new(fcPos) * rot
		end)
	else
		if fcConn then fcConn:Disconnect();  fcConn = nil end
		if fcInputConn then fcInputConn:Disconnect();  fcInputConn = nil end
		pcall(function() UIS.MouseBehavior = Enum.MouseBehavior.Default end)
		cam.CameraType = Enum.CameraType.Custom
		local realHum2 = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
		cam.CameraSubject = piloting and hum or realHum2 or hum
	end
	if freecamBtn then
		freecamBtn.BackgroundColor3 = on and Color3.fromRGB(90, 130, 190) or Color3.fromRGB(46, 46, 56)
		freecamBtn.Text = on and "Freecam: ON" or "Freecam"
	end
end
