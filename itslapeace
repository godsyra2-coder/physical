--// each pose -> { root=CFrame, neck, ls, rs, lh, rh } (transforms in each joint's frame)
local POSE = {}
function POSE.idle(t)
	local s = math.sin(t * 1.3)
	return {
		root = CFrame.new(0, 0, -(1 - math.cos(t * 2.6)) * 0.015),
		neck = ang(s * math.rad(1.4), 0, 0),
		ls = ang(0, 0,  math.rad(6) + s * math.rad(1.6)),
		rs = ang(0, 0, -math.rad(6) - s * math.rad(1.6)),
		lh = ang(0, 0,  s * math.rad(0.7)),
		rh = ang(0, 0, -s * math.rad(0.7)),
	}
end
function POSE.walk(t)
	local s = math.sin(t)
	return {
		root = CFrame.new(0, 0, -(1 - math.cos(t * 2)) * 0.5 * WALK.bob) * ang(math.rad(4), 0, 0),
		neck = ang(math.sin(t * 2) * math.rad(1), 0, 0),
		ls = ang(0, 0, -s * WALK.arm),
		rs = ang(0, 0, -s * WALK.arm),
		lh = ang(0, 0,  s * WALK.leg),
		rh = ang(0, 0,  s * WALK.leg),
	}
end
function POSE.run(t)
	local s = math.sin(t)
	return {
		root = CFrame.new(0, 0, -(1 - math.cos(t * 2)) * 0.5 * WALK.bob * 1.7) * ang(math.rad(15), 0, 0),
		neck = ang(math.rad(-7), 0, 0),
		ls = ang(math.rad(-30), 0, -s * WALK.arm * 1.45),
		rs = ang(math.rad(-30), 0, -s * WALK.arm * 1.45),
		lh = ang(0, 0,  s * WALK.leg * 1.4),
		rh = ang(0, 0,  s * WALK.leg * 1.4),
	}
end
function POSE.jump()                                        -- arms up, knees tucked forward
	return { root = ang(math.rad(6), 0, 0), neck = ang(-math.rad(5), 0, 0),
		ls = ang(math.rad(6), 0, -math.rad(116)), rs = ang(math.rad(6), 0, math.rad(116)),
		lh = ang(0, 0, -math.rad(26)), rh = ang(0, 0, math.rad(26)) }
end
function POSE.fall(t)                                       -- arms spread wide to the sides (skydiver), flailing
	local f = math.sin(t * 8) * math.rad(12)
	return { root = ang(math.rad(2), 0, 0), neck = ang(-math.rad(3), 0, 0),
		ls = ang(-(math.rad(120) + f), 0, 0), rs = ang(-(math.rad(120) - f), 0, 0),   -- right arm X negated
		lh = ang(0, 0, -math.rad(12)), rh = ang(0, 0, math.rad(12)) }
end
function POSE.land()                                        -- crouch, arms forward for balance
	return { root = CFrame.new(0, 0, -WALK.bob * 2.2) * ang(math.rad(9), 0, 0), neck = ang(math.rad(-5), 0, 0),
		ls = ang(math.rad(8), 0, -math.rad(40)), rs = ang(math.rad(8), 0, math.rad(40)),
		lh = ang(0, 0, -math.rad(22)), rh = ang(0, 0, math.rad(22)) }
end
function POSE.climb(t)                                      -- reach up the wall, alternating arms & legs
	local s = math.sin(t * 5)
	return { root = ang(math.rad(4), 0, 0), neck = ang(math.rad(-4), 0, 0),
		ls = ang(math.rad(10), 0, -(math.rad(96) + s * math.rad(34))), rs = ang(math.rad(10), 0, (math.rad(96) - s * math.rad(34))),
		lh = ang(0, 0, -(math.rad(20) - s * math.rad(22))), rh = ang(0, 0, (math.rad(20) + s * math.rad(22))) }
end
--// ---- procedural dances ----
--// mirror rule (confirmed by the walk): SAME local value on both shoulders/hips -> limbs move OPPOSITE in world
--// (walk stride / T-pose splay); OPPOSITE local values -> limbs move the SAME way (both arms forward / both to one side).
--// Fortnite "Criss Cross" — a 2-step loop, snap to each pose then hold (not a sine oscillation):
--//   step 1: legs crossed on X (left leg tucked behind the front one), RIGHT arm raised 90, left arm down
--//   step 2: legs open,                                                LEFT  arm raised 90, right arm down
local CC_Xc, CC_Xo, CC_Zf = math.rad(32), math.rad(27), math.rad(15)
local function CC_pose(step)
	if step == 0 then
		return {
			root = ang(math.rad(4), math.rad(7), 0),  neck = ang(math.rad(2), math.rad(-5), 0),
			ls = ang(0, 0, -math.rad(7)),  rs = ang(0, 0,  math.rad(90)),
			lh = ang(CC_Xc, 0,  CC_Zf),    rh = ang(CC_Xc, 0,  CC_Zf),   -- mirrored C0 => +Z is fwd on R, back on L
		}
	end
	return {
		root = ang(math.rad(4), -math.rad(7), 0),  neck = ang(math.rad(2), math.rad(5), 0),
		ls = ang(0, 0, -math.rad(90)),  rs = ang(0, 0,  math.rad(7)),
		lh = ang(-CC_Xo, 0, 0),         rh = ang(-CC_Xo, 0, 0),
	}
end
function POSE.crisscross(t)
	local T    = t * 0.72                                   -- ~0.47s per step
	local step = math.floor(T) % 2
	local k    = T - math.floor(T)
	local e    = math.clamp(k / 0.28, 0, 1);  e = e * e * (3 - 2 * e)   -- snap over first 28%, then hold
	local from, to = CC_pose(1 - step), CC_pose(step)
	local hitch = math.abs(math.sin(k * math.pi)) * 0.06                -- little bob on the swap
	return {
		root = from.root:Lerp(to.root, e) * CFrame.new(0, 0, -hitch),
		neck = from.neck:Lerp(to.neck, e),
		ls = from.ls:Lerp(to.ls, e),  rs = from.rs:Lerp(to.rs, e),
		lh = from.lh:Lerp(to.lh, e),  rh = from.rh:Lerp(to.rh, e),
	}
end
function POSE.disco(t)                                      -- Travolta: one arm points up-diagonal, switch on the beat
	local beat = math.floor(t * 2) % 2
	local u = math.sin(t * 4) * math.rad(6)
	return {
		root = ang(math.rad(2), math.sin(t * 2) * math.rad(12), 0),
		neck = ang(0, math.sin(t * 2) * math.rad(7), 0),
		ls = beat == 0 and ang(math.rad(18), 0, -(math.rad(142) + u)) or ang(0, 0, -math.rad(16)),
		rs = beat == 1 and ang(math.rad(18), 0,  (math.rad(142) + u)) or ang(0, 0,  math.rad(16)),
		lh = ang(0, 0, -math.sin(t * 4) * math.rad(7)),
		rh = ang(0, 0,  math.sin(t * 4) * math.rad(7)),
	}
end
function POSE.robot(t)                                      -- stiff, stepped: arm snaps to forward-horizontal, alternating
	local q = math.floor(t * 3) % 4
	local aL = (q == 0 or q == 1) and math.rad(86) or math.rad(16)
	local aR = (q == 2 or q == 3) and math.rad(86) or math.rad(16)
	return {
		root = ang(math.rad(2), (q < 2 and 1 or -1) * math.rad(12), 0),
		neck = ang(0, (q < 2 and -1 or 1) * math.rad(16), 0),
		ls = ang(0, 0, -aL),
		rs = ang(0, 0,  aR),
		lh = ang(0, 0, -(q == 1 and math.rad(16) or 0)),
		rh = ang(0, 0,  (q == 3 and math.rad(16) or 0)),
	}
end
function POSE.hype(t)                                       -- jump-around hype: both arms overhead, big bounce
	local bn = math.abs(math.sin(t * 5))
	local sw = math.sin(t * 2.5)
	local fl = math.sin(t * 10) * math.rad(12)
	return {
		root = CFrame.new(0, 0, -bn * 0.22) * ang(math.rad(-2), sw * math.rad(20), 0),
		neck = ang(bn * math.rad(-8), 0, 0),
		ls = ang(math.rad(12), 0, -(math.rad(150) + fl)),   -- both arms up, hands near center, flailing
		rs = ang(math.rad(12), 0,  (math.rad(150) + fl)),
		lh = ang(0, 0, -bn * math.rad(16)),
		rh = ang(0, 0,  bn * math.rad(16)),
	}
end

