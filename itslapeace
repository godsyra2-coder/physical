		  bmat=Enum.Material.DiamondPlate, lmat=Enum.Material.Metal, col=Color3.fromRGB(46,48,54), refl=0.1, trans=0, acc=Color3.fromRGB(255,120,20),
		  bsz=Vector3.new(5.4,2.1,6.2), hsz=Vector3.new(3.8,2.3,4.2), mech=true, spikes=true,
		  particle={ col=Color3.fromRGB(255,120,20), rate=14, rear=true } },
	}
	local ssIdx = 1
	local function acCol() return SSKINS[ssIdx].acc or glow() end

	local function applySSkin(n)
		ssIdx = (((n or ssIdx + 1) - 1) % #SSKINS) + 1
		local S = SSKINS[ssIdx]
		CFG.SP, CFG.W, CFG.FEMUR, CFG.TIBIA = S.sp, S.w, S.fem, S.tib
		CFG.REACH, CFG.BODY_H, CFG.SWING, CFG.LIFT = S.reach, S.bh, S.sw, S.lift
		CFG.GRATE, CFG.GBOB, CFG.ANG, CFG.mech = S.grate, S.gbob, S.ang, S.mech or false
		local sp, ac = S.sp, acCol()
		local tr = spiderOn and (S.trans or 0) or 1
		local acT = spiderOn and 0 or 1
		local mShow = (S.mech and spiderOn) and (S.trans or 0) or 1   -- mech dress-up parts (MaxMech only)
		local mAcc  = (S.mech and spiderOn) and 0 or 1

		for i, l in ipairs(legs) do
			local a = math.rad(S.ang[i])
			l.out  = Vector3.new(math.sin(a), 0, math.cos(a))
			l.hipL = l.out * (CFG.HIP_R * sp) + Vector3.new(0, CFG.HIP_UP * sp, 0)
			l.shoL = l.out * ((CFG.HIP_R + CFG.SHO_OUT) * sp) + Vector3.new(0, (CFG.HIP_UP + CFG.SHO_UP) * sp, 0)
			local w = S.w * sp
			for _, part in ipairs({ l.coxa, l.femur, l.tibia }) do
				part.Material, part.Color, part.Reflectance, part.Transparency = S.lmat, S.col, S.refl or 0, tr
			end
			l.coxa.Size  = Vector3.new(w*1.4, w*1.4, 1)
			l.femur.Size = Vector3.new(w, w, S.fem * sp)
			l.tibia.Size = Vector3.new(w*0.82, w*0.82, S.tib * sp)
			l.tip.Size,  l.tip.Color,  l.tip.Transparency  = Vector3.new(w*0.9, w*0.9, 1.2*sp), ac, acT
			l.jHip.Size, l.jHip.Color, l.jHip.Transparency  = Vector3.new(0.55*sp, 0.55*sp, 0.55*sp), ac, acT
			l.jKnee.Size, l.jKnee.Color, l.jKnee.Transparency = Vector3.new(0.48*sp, 0.48*sp, 0.48*sp), ac, acT
			for _, mp in ipairs({ l.mBarrel, l.mRod, l.mHipBox, l.mKneeBox, l.mPlate }) do
				mp.Material, mp.Color, mp.Reflectance, mp.Transparency = S.lmat, S.col, S.refl or 0, mShow
			end
			l.mRod.Material, l.mRod.Color, l.mRod.Reflectance = Enum.Material.Metal, Color3.fromRGB(205, 210, 220), 0.4
			l.mHipRing.Color, l.mHipRing.Transparency  = ac, mAcc
			l.mKneeRing.Color, l.mKneeRing.Transparency = ac, mAcc
		end

		body.Size, body.Material, body.Color, body.Reflectance, body.Transparency = S.bsz*sp, S.bmat, S.col, S.refl or 0, tr
		hull.Size, hull.Color, hull.Reflectance, hull.Transparency = S.hsz*sp, S.col, S.refl or 0, tr
		core.Size,  core.Color,  core.Transparency  = Vector3.new(1.5*sp, 0.5*sp, 3.0*sp), ac, acT
		under.Size, under.Color, under.Transparency = Vector3.new(2.2*sp, 0.3*sp, 2.6*sp), ac, acT
		eye.Size,   eye.Color,   eye.Transparency   = Vector3.new(0.6*sp, 0.6*sp, 0.6*sp), ac, acT
		mand1.Size, mand1.Color, mand1.Transparency = Vector3.new(S.w*sp, S.w*sp, 1.6*sp), S.col, tr
		mand2.Size, mand2.Color, mand2.Transparency = mand1.Size, S.col, tr

		abdo.Size, abdo.Color = Vector3.new(2.8*sp, 2.6*sp, 3.4*sp), S.col
		abdo.Transparency = (S.abdomen and spiderOn) and (S.trans or 0) or 1
		for _, k in ipairs(spikes) do
			k.Size, k.Color = Vector3.new(0.28*sp, 0.28*sp, 1.5*sp), DKR
			k.Transparency  = (S.spikes and spiderOn) and 0 or 1
		end
		if S.particle then
			particle.Enabled = spiderOn
			particle.Rate = S.particle.rate or 20
			particle.Color = ColorSequence.new(S.particle.col or ac)
			pAtt.Position = Vector3.new(0, -0.3*sp, S.particle.rear and 2.2*sp or 0)
		else
			particle.Enabled = false
		end

		task.spawn(function()
			local mesh, mat = {}, {}
			if sBody then
				mesh[#mesh+1] = { Part = sBody, Scale = S.bsz * sp * MESH_SCALE }
				mat[#mat+1]   = { Part = sBody, Color = S.col }
			end
			for _, s in ipairs(sSeg) do
				local w = S.w * sp * MESH_SCALE
				local len = ((s.k == "f") and S.fem or S.tib) * sp * MESH_SCALE
				mesh[#mesh+1] = { Part = s.part, Scale = Vector3.new(w, w, len) }
				mat[#mat+1]   = { Part = s.part, Color = S.col }
			end
			if #mesh > 0 then pcall(invoke, ep, "SyncMesh", mesh) end
			if #mat > 0 then pcall(invoke, ep, "SyncColor", mat) end
		end)

		if ssBtn then ssBtn.Text = "SSkin: " .. S.name end
	end
	_G.R6Rig_SSkin = applySSkin

