_G.R6Rig_Stop = function()
	alive = false
	pcall(function() RunService:UnbindFromRenderStep("R6RigSword") end)
	if piloting then setPilot(false) end
	stopTrack()
	if gui then gui:Destroy() end
	if localModel then localModel:Destroy() end
	local rm = {}
	for _, p in pairs(serverParts) do rm[#rm + 1] = p end
	if swordBlade then rm[#rm + 1] = swordBlade end
	if tessParts then for _, e in ipairs(tessParts) do if e.sp then rm[#rm + 1] = e.sp end end end
	if #rm > 0 then pcall(function() ep:InvokeServer("Remove", rm) end) end
	print("[rig] stopped")
end

