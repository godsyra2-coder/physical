--// ---------- SERVER rig ----------
local serverParts = {}
do
	local done = 0
	for _, s in ipairs(RIG) do
		task.spawn(function()
			if s.name ~= "HumanoidRootPart" then   -- HRP is invisible + non-colliding: no server part needed
				local cf = getTargetCF() * s.offset
				local part = ep:InvokeServer("CreatePart", "Normal", cf, workspace)
				if part then
					EscalateEvent:FireServer(PartOwnership, { [1] = part })
					local t0 = os.clock()
					repeat task.wait(0.01) until part:FindFirstChild("RRPartOwner") or (os.clock() - t0) > 5
					if part:FindFirstChild("RRPartOwner") then
						ep:InvokeServer("SyncResize",    { [1] = { Part = part, Size = s.size * MICRO, CFrame = cf } })
						ep:InvokeServer("SetName",       { part }, s.name)
						ep:InvokeServer("SyncColor",     { [1] = { Part = part, Color = s.color } })
						ep:InvokeServer("SyncMaterial",  { [1] = { Part = part, Material = Enum.Material.Plastic, Transparency = s.transparency or 0 } })
						ep:InvokeServer("SyncCollision", { [1] = { Part = part, CanCollide = false } })
						ep:InvokeServer("CreateMeshes",  { [1] = { Part = part } })
						--// FileMesh Scale is ABSOLUTE (not part-relative like BlockMesh) - no 1/MICRO multiplier.
						local meshId = (s.name == "Head") and HEAD_MESH or BODY_MESH[s.name]
						local ms = (s.name == "Head") and HEAD_MESH_SCALE or BODY_MESH_SCALE
						if meshId then
							ep:InvokeServer("SyncMesh", { [1] = { Part = part, MeshType = Enum.MeshType.FileMesh,
								MeshId = meshId, Scale = Vector3.new(ms, ms, ms) } })
						else
							ep:InvokeServer("SyncMesh", { [1] = { Part = part, MeshType = Enum.MeshType.Brick,
								Scale = Vector3.new(MESH_SCALE, MESH_SCALE, MESH_SCALE) } })
						end
						ep:InvokeServer("SyncAnchor",    { [1] = { Part = part, Anchored = true } })
						castShadowOff(part)
						serverParts[s.name] = part
					end
				end
			end
			done += 1
		end)
		task.wait(0.0001)
	end
	repeat task.wait() until done >= #RIG
	local all = {}
	for _, s in ipairs(RIG) do if serverParts[s.name] then all[#all + 1] = serverParts[s.name] end end
	if #all > 0 then
		local m = ep:InvokeServer("CreateGroup", "Model", workspace, all)
		if m then ep:InvokeServer("SetName", { m }, "R6Rig") end
	end
	print("[rig] server rig:", #all, "/", #RIG - 1)
end

