swordSwing = function()
	if not swordOn then return end
	local now = os.clock()
	swingStage = (now - swingStamp < 1.4) and (swingStage % 3) + 1 or 1
	swingStamp = now
	local lunge = (swingStage == 3)
	swordAnim  = lunge and "lunge" or "slash"
	swordAnimT = 0
	swordAnimDur = lunge and 0.5 or 0.42

	local snd = localSword:FindFirstChild(lunge and "LungeSound" or "SlashSound")
	if snd then snd:Play() end
	if swordTrail then
		swordTrail.Enabled = true
		task.delay(swordAnimDur, function() if swordTrail then swordTrail.Enabled = false end end)
	end

	--// CHECK FOR HITS AND REMOVE ENEMY HEADS (instant kill via F3X exploit)
	checkSwordHit()

	if lunge then                                     -- forward lunge hop
		local hrp = localParts.HumanoidRootPart
		local lk = hrp.CFrame.LookVector
		local bv = Instance.new("BodyVelocity")
		bv.MaxForce = Vector3.new(1, 1, 1) * 4e5
		bv.Velocity = Vector3.new(lk.X, 0, lk.Z).Unit * 34 + Vector3.new(0, 9, 0)
		bv.Parent = hrp
		game:GetService("Debris"):AddItem(bv, 0.3)
	end
end
