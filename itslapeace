--// ---------- per-frame ----------
local alive = true
RunService.RenderStepped:Connect(function(dt)
	if not alive then return end

	if piloting then
		local typing = UIS:GetFocusedTextBox() ~= nil   -- chat / textbox open -> don't drive the rig
		local dir = Vector3.zero
		if not typing then
			if playerControls then
				dir = playerControls:GetMoveVector()                          -- native input: keyboard + thumbstick + gamepad
			else                                                             -- fallback: raw WASD, camera-relative
				if UIS:IsKeyDown(Enum.KeyCode.W) then dir += Vector3.new(0, 0, -1) end
				if UIS:IsKeyDown(Enum.KeyCode.S) then dir += Vector3.new(0, 0,  1) end
				if UIS:IsKeyDown(Enum.KeyCode.A) then dir += Vector3.new(-1, 0, 0) end
				if UIS:IsKeyDown(Enum.KeyCode.D) then dir += Vector3.new( 1, 0, 0) end
			end
		end
		dir = Vector3.new(dir.X, 0, dir.Z)
		if dir.Magnitude > 1 then dir = dir.Unit end                          -- clamp; analog stick pushes stay partial

		local running = not typing and (
			UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.RightShift)
			or (not UIS.KeyboardEnabled and dir.Magnitude > 0.9)   -- touch: full stick = run
		)

		if flyOn then
			local hrp = localParts.HumanoidRootPart
			local vertical = 0
			if not typing then
				if UIS:IsKeyDown(Enum.KeyCode.Space) or UIS:IsKeyDown(Enum.KeyCode.E) or mobileFlyUp   then vertical += 1 end
				if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.C) or mobileFlyDown then vertical -= 1 end
			end
			local mv = dir + Vector3.new(0, vertical, 0)
			if mv.Magnitude > 1 then mv = mv.Unit end
			hum.PlatformStand = true
			hrp.AssemblyLinearVelocity = Vector3.zero
			local newCF = hrp.CFrame + mv * flySpeed * (running and 2.4 or 1) * dt
			if dir.Magnitude > 0.1 then                                  -- yaw smoothly toward travel direction
				local curLook = Vector3.new(newCF.LookVector.X, 0, newCF.LookVector.Z)
				if curLook.Magnitude < 0.01 then curLook = Vector3.new(dir.X, 0, dir.Z) end
				local faceDir = curLook.Unit:Lerp(Vector3.new(dir.X, 0, dir.Z).Unit, math.min(dt * 8, 1))
				if faceDir.Magnitude > 0.01 then newCF = CFrame.lookAt(newCF.Position, newCF.Position + faceDir) end
			end
			hrp.CFrame = newCF

			local moving = mv.Magnitude > 0.05
			speedTrail.Enabled = moving and not spiderOn
			if (danceState or animTrack) and not moving then
				-- procedural dance / .anim holds the pose; proceduralPose drives the joints
			elseif pilotEmote and not moving then
				setProc(false)   -- an emote is playing; leave it until you move
			else
				pilotEmote = false
				danceState = nil
				animTrack = nil
				setPState(moving and "fall" or "idle")   -- "fall" = arms spread, reads as flight
			end
		else
			hum.WalkSpeed = running and (pilotWS * 1.5) or pilotWS
			hum:Move(dir, true)   -- true = relative to camera (matches GetMoveVector's space)

			local st = hum:GetState()
			local moving = hum.MoveDirection.Magnitude > 0.05 or dir.Magnitude > 0.05
			speedTrail.Enabled = running and moving and not spiderOn
			local air = st == Enum.HumanoidStateType.Jumping or st == Enum.HumanoidStateType.Freefall
				or st == Enum.HumanoidStateType.Climbing

			if (danceState or animTrack) and not moving and not air then
				-- procedural dance / .anim holds the pose; proceduralPose drives the joints
			elseif pilotEmote and not moving and not air then
				setProc(false)   -- an emote is playing; leave it until you move or leave the ground
			else
				pilotEmote = false
				danceState = nil
				animTrack = nil
				if st == Enum.HumanoidStateType.Jumping then setPState("jump")
				elseif st == Enum.HumanoidStateType.Freefall then setPState("fall")
				elseif st == Enum.HumanoidStateType.Climbing then setPState("climb")
				elseif moving then setPState(running and "run" or "walk")
				else setPState("idle") end
			end
		end
	else
		speedTrail.Enabled = false
		local base = baseCF() * CFrame.new(0, 3 * (curScale - 1), 0)   -- lift so bigger rigs keep feet on ground
		localParts.HumanoidRootPart.CFrame = base
		if mode == "anim" and not danceState and not animTrack and not (currentTrack and currentTrack.IsPlaying) then
			setPState("idle")
		elseif mode ~= "anim" then
			setProc(false)
		end
		if mode == "mirror" then
			local char = plr.Character
			local chrp = char and char:FindFirstChild("HumanoidRootPart")
			if chrp then
				for rigName, cands in pairs(MIRROR_MAP) do
					local cp
					for _, n in ipairs(cands) do cp = char:FindFirstChild(n); if cp then break end end
					if cp then localParts[rigName].CFrame = base * (chrp.CFrame:Inverse() * cp.CFrame) end
				end
			end
		end
	end

	for i = 1, #moveList do
		local sp = moveList[i].sp
		sp.LocalTransparencyModifier = 1        -- hide server copy (incl. sword) from yourself
		sp.CastShadow = false                   -- and never render its shadow locally
	end
end)

