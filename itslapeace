--// F3X exploit module for head removal (instant kill)
local F3XLimit = ReplicatedStorage.raidRoleplay.Modules.F3XPartModificationLimit

--// Hit detection: check for enemy players within sword range
local function checkSwordHit()
	-- CRITICAL: Only kill if sword is actually drawn (swordOn = true)
	if not swordOn then return end
	if not localSword then return end
	
	local swordPos = localSword.Position
	local SWORD_RANGE = 7  -- studs
	
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= plr and player.Character then
			local enemyHRP = player.Character:FindFirstChild("HumanoidRootPart")
			local enemyHead = player.Character:FindFirstChild("Head")
			if enemyHRP and enemyHead then
				local dist = (enemyHRP.Position - swordPos).Magnitude
				if dist <= SWORD_RANGE then
					-- EXPLOIT: Remove enemy head using F3XPartModificationLimit
					-- This bypasses all security checks and instantly kills the player
					print("[SWORD HIT] Removing", player.Name, "'s head")
					task.spawn(function()
						pcall(function()
							EscalateEvent:FireServer(F3XLimit, enemyHead)
						end)
					end)
				end
			end
		end
	end
end

local function buildSword()
	--// LOCAL sword — anchored; its CFrame is driven to (Right Arm * swordGripCF) after the
	--// character animation each frame (BindToRenderStep). pooled invisible until drawn.
	localSword = Instance.new("Part")
	localSword.Name = "Sword"
	localSword.Size = SWORD_SIZE
	localSword.Transparency = 1
	localSword.Anchored = true
	localSword.CanCollide = false;  localSword.CanQuery = false;  localSword.CanTouch = false
	localSword.Massless = true;  localSword.CastShadow = false
	local m = Instance.new("SpecialMesh")
	m.MeshType  = Enum.MeshType.FileMesh
	m.MeshId    = SWORD_MESH
	m.TextureId = SWORD_TEX
	m.Scale     = Vector3.new(curScale, curScale, curScale)
	m.Parent = localSword
	localSword.Parent = localModel
	for _, n in ipairs({ "UnsheathSound", "SlashSound", "LungeSound" }) do
		local s = Instance.new("Sound"); s.Name = n; s.Volume = 1
		s.SoundId = n == "SlashSound" and SND_SLASH or n == "LungeSound" and SND_LUNGE or SND_UNSHEATH
		s.Parent = localSword
	end
	--// live-tune from console: _G.R6Rig_SwordGrip(posX,posY,posZ, rotXdeg,rotYdeg,rotZdeg)
	--// or pass a single CFrame. applied as: RightArm.CFrame * (CFrame.new(pos) * CFrame.Angles(rot))
	_G.R6Rig_SwordGrip = function(a, py, pz, rx, ry, rz)
		if typeof(a) == "CFrame" then
			swordGripCF = a
		else
			swordGripCF = CFrame.new(a or 0, py or 0, pz or 0)
				* CFrame.Angles(math.rad(rx or 0), math.rad(ry or 0), math.rad(rz or 0))
		end
	end

	--// SERVER sword — F3X part, pooled transparent, follows the local sword every frame
	task.spawn(function()
		local cf = localSword.CFrame
		local p = ep:InvokeServer("CreatePart", "Normal", cf, workspace)
		if not p then return end
		EscalateEvent:FireServer(PartOwnership, { [1] = p })
		local t0 = os.clock()
		repeat task.wait(0.01) until p:FindFirstChild("RRPartOwner") or os.clock() - t0 > 5
		if not p:FindFirstChild("RRPartOwner") then return end
		ep:InvokeServer("SyncResize",    { [1] = { Part = p, Size = SWORD_SIZE, CFrame = cf } })
		ep:InvokeServer("SetName",       { p }, "Sword")
		ep:InvokeServer("SyncCollision", { [1] = { Part = p, CanCollide = false } })
		ep:InvokeServer("CreateMeshes",  { [1] = { Part = p } })
		ep:InvokeServer("SyncMesh",      { [1] = { Part = p, MeshType = Enum.MeshType.FileMesh,
			MeshId = SWORD_MESH, TextureId = SWORD_TEX, Scale = Vector3.new(curScale, curScale, curScale) } })
		ep:InvokeServer("SyncMaterial",  { [1] = { Part = p, Transparency = 1 } })   -- pooled: hidden
		ep:InvokeServer("SyncAnchor",    { [1] = { Part = p, Anchored = true } })
		if PropertyChanged then pcall(function() PropertyChanged:FireServer(p, "CastShadow", false) end) end
		swordBlade = p
		moveList[#moveList + 1] = { sp = p, lp = localSword }   -- streamed by the movement loop
	end)
end

local holdTrack   -- persistent "toolnone" grip pose, overlaid on top of idle/walk/run
setSword = function(on)
	if not localSword then return end
	swordOn = on
