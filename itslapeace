--// ---------- per-frame ----------
local alive = true
RunService.RenderStepped:Connect(function()
	if not alive then return end

	if piloting then
		local typing = UIS:GetFocusedTextBox() ~= nil   -- chat / textbox open -> don't drive the rig
		local dir = Vector3.zero
		if not typing then
			if playerControls then
				dir = playerControls:GetMoveVector()                          -- native input: keyboard + thumbstick + gamepad
			else                                                             -- fallback: raw WASD, camera-relative
				if UIS:IsKeyDown(Enum.KeyCode.W) then dir += Vector3.new(0, 0, -1) end
				if UIS:IsKeyDown(Enum.KeyCode.S) then dir += Vector3.new(0, 0,  1) end
				if UIS:IsKeyDown(Enum.KeyCode.A) then dir += Vector3.new(-1, 0, 0) end
				if UIS:IsKeyDown(Enum.KeyCode.D) then dir += Vector3.new( 1, 0, 0) end
			end
		end
		dir = Vector3.new(dir.X, 0, dir.Z)
		if dir.Magnitude > 1 then dir = dir.Unit end                          -- clamp; analog stick pushes stay partial

		local running = not typing and (
			UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.RightShift)
			or (not UIS.KeyboardEnabled and dir.Magnitude > 0.9)   -- touch: full stick = run
		)
		hum.WalkSpeed = running and 24 or 16
		hum:Move(dir, true)   -- true = relative to camera (matches GetMoveVector's space)

		local st = hum:GetState()
		local moving = hum.MoveDirection.Magnitude > 0.05 or dir.Magnitude > 0.05
		local air = st == Enum.HumanoidStateType.Jumping or st == Enum.HumanoidStateType.Freefall
			or st == Enum.HumanoidStateType.Climbing

		if pilotEmote and not moving and not air then
			-- an emote is playing: leave the animation alone until you move or leave the ground
		else
			pilotEmote = false
			if st == Enum.HumanoidStateType.Jumping then
				autoAnim("jump")
			elseif st == Enum.HumanoidStateType.Freefall then
				autoAnim("fall")
			elseif st == Enum.HumanoidStateType.Climbing then
				autoAnim("climb")
			elseif moving then
				autoAnim(running and "run" or "walk")
				if currentTrack then currentTrack:AdjustSpeed(hum.WalkSpeed / 16) end
			else
				autoAnim("idle")   -- toolnone is a separate persistent overlay (holdTrack), not a state
			end
		end
	else
		local base = baseCF() * CFrame.new(0, 3 * (curScale - 1), 0)   -- lift so bigger rigs keep feet on ground
		localParts.HumanoidRootPart.CFrame = base
		if mode == "mirror" then
			local char = plr.Character
			local chrp = char and char:FindFirstChild("HumanoidRootPart")
			if chrp then
				for rigName, cands in pairs(MIRROR_MAP) do
					local cp
					for _, n in ipairs(cands) do cp = char:FindFirstChild(n); if cp then break end end
					if cp then localParts[rigName].CFrame = base * (chrp.CFrame:Inverse() * cp.CFrame) end
				end
			end
		end
	end

	for i = 1, #moveList do
		local sp = moveList[i].sp
		sp.LocalTransparencyModifier = 1        -- hide server copy (incl. sword) from yourself
		sp.CastShadow = false                   -- and never render its shadow locally
	end
end)

--// sword follows the Right Arm AFTER the animation pose is applied, so grip pos+rot always land
RunService:BindToRenderStep("R6RigSword", Enum.RenderPriority.Character.Value + 1, function()
	if alive and localSword then
		local g = swordGripCF
		local grip = (g - g.Position) + g.Position * curScale   -- keep rotation, scale the offset with the rig
		localSword.CFrame = localParts["Right Arm"].CFrame * grip
	end
end)

--// ---------- movement replicator: fire-and-forget, changed-parts-only ----------
--// never wait on a reply. only send a part whose pose actually moved since last send,
--// so idle limbs don't hog the pipe and the parts that DO move get through sooner.
--// sent on Stepped and Heartbeat both -> 2 fresh samples per rendered frame.
local invoke = ep.InvokeServer
local function fire(b) pcall(invoke, ep, "SyncMove", b) end

do
	local last = {}
	local function push()
		if not alive then return end
		local batch
		for i = 1, #moveList do   -- live length: the sword blade is appended later
			local cf = moveList[i].lp.CFrame
			local p = last[i]
			if (not p) or (cf.Position - p.Position).Magnitude > 0.02
			   or cf.LookVector:Dot(p.LookVector) < 0.9997 then
				last[i] = cf
				batch = batch or {}
				batch[#batch + 1] = { Part = moveList[i].sp, CFrame = cf }
			end
		end
		if batch then
			for _ = 1, SENDS_PER_TICK do task.spawn(fire, batch) end
		end
	end
	RunService.Stepped:Connect(push)
	RunService.Heartbeat:Connect(push)
end

--// ---------- noob size (scales local skeleton + server BlockMesh) ----------
local SCALE_MIN, SCALE_MAX = 0.1, 12
local SCALE_MID = math.log(1 / SCALE_MIN) / math.log(SCALE_MAX / SCALE_MIN)   -- knob fraction where k = 1x
local function scalePos(cf, k)
	local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
	return CFrame.new(x * k, y * k, z * k, r00, r01, r02, r10, r11, r12, r20, r21, r22)
end
local meshStamp = 0
local function setScale(k)
	curScale = k
	for _, s in ipairs(RIG) do localParts[s.name].Size = s.size * k end           -- local skeleton, live
	for _, r in ipairs(motorRec) do
		r.inst.C0 = scalePos(r.c0, k)
		r.inst.C1 = scalePos(r.c1, k)
	end
	if localSword then                                                            -- sword scales with the rig
		local sm = localSword:FindFirstChildOfClass("SpecialMesh")
		if sm then sm.Scale = Vector3.new(k, k, k) end
	end
	for _, s in ipairs(RIG) do                                                    -- local head + body meshes
		local m = localParts[s.name]:FindFirstChildOfClass("SpecialMesh")
		if m then
			local ms = (s.name == "Head") and HEAD_MESH_SCALE or BODY_MESH_SCALE
			m.Scale = Vector3.new(ms * k, ms * k, ms * k)
		end
	end
	local stamp = os.clock()
	meshStamp = stamp
	task.delay(0.05, function()                                                   -- server meshes, debounced
		if meshStamp ~= stamp then return end
		local headS, bodyS = HEAD_MESH_SCALE * k, BODY_MESH_SCALE * k
		local head = Vector3.new(headS, headS, headS)
		local body = Vector3.new(bodyS, bodyS, bodyS)
		for _, e in ipairs(moveList) do
			task.spawn(function()
				pcall(invoke, ep, "SyncMesh", { [1] = { Part = e.sp,
					Scale = e.head and head or e.body and body or Vector3.new(k, k, k) } })
			end)
		end
	end)
end
_G.R6Rig_Scale = setScale

