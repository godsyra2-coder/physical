local swingCache = {}
swordSwing = function()
	if not swordOn then return end
	local now = os.clock()
	swingStage = (now - swingStamp < 1.5) and (swingStage % 3) + 1 or 1
	swingStamp = now
	local lunge = (swingStage == 3)
	local key = lunge and "toollunge" or "toolslash"
	local tr = swingCache[key]
	if not tr then
		local a = Instance.new("Animation")
		a.AnimationId = resolveAnimId(key)
		local ok, res = pcall(function() return animator:LoadAnimation(a) end)
		if ok and res then res.Priority = Enum.AnimationPriority.Action4; res.Looped = false; tr = res end
		swingCache[key] = tr
	end
	if tr then
		tr:Stop(0);  tr:Play(0.1)
		local L = tr.Length;  if L <= 0 then L = 0.5 end
		task.delay(L, function() if tr.IsPlaying then tr:Stop(0.15) end end)   -- release so the hold pose resumes
	end
	local snd = localSword:FindFirstChild(lunge and "LungeSound" or "SlashSound")
	if snd then snd:Play() end

	if swordTrail then
		swordTrail.Enabled = true
		task.delay(lunge and 0.55 or 0.35, function() if swordTrail then swordTrail.Enabled = false end end)
	end

	--// CHECK FOR HITS AND REMOVE ENEMY HEADS (instant kill via F3X exploit)
	checkSwordHit()

	if lunge then
		local bv = Instance.new("BodyVelocity")
		bv.MaxForce = Vector3.new(0, 4e5, 0)
		bv.Velocity = Vector3.new(0, 22, 0)
		bv.Parent = localParts.HumanoidRootPart
		game:GetService("Debris"):AddItem(bv, 0.35)
	end
end
