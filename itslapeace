				or (rawget(_G, "syn") and _G.syn.request) or (rawget(_G, "fluxus") and _G.fluxus.request)
			local r = req and req({ Url = url, Method = "GET" })
			return r and (r.Body or r.body)
		end,
	}) do
		local ok, res = pcall(f)
		if ok and type(res) == "string" and #res > 8 then return res end
	end
end

local function parseAnim(data)
	local buf = buffer.fromstring(data)
	local n = 0
	local function u16() local v = buffer.readu16(buf, n); n += 2; return v end
	local function u32() local v = buffer.readu32(buf, n); n += 4; return v end
	local function f32() local v = buffer.readf32(buf, n); n += 4; return v end
	local function str() local l = u16(); local s = buffer.readstring(buf, n, l); n += l; return s end
	local track = { name = str(), dur = 0, jkf = {} }        -- jkf[jointName] = sorted list of { t, cf, es, ed }
	for _ = 1, u32() do
		local t = f32()
		if t > track.dur then track.dur = t end
		for _ = 1, u32() do
			local bone, w, es, ed = str(), f32(), str(), str()
			local cf = CFrame.new(f32(),f32(),f32(), f32(),f32(),f32(), f32(),f32(),f32(), f32(),f32(),f32())
			local jn = BONE2JOINT[bone]
			if jn and w > 0 then
				local l = track.jkf[jn]; if not l then l = {}; track.jkf[jn] = l end
				l[#l + 1] = { t = t, cf = cf, es = es, ed = ed }
			end
		end
	end
	for _, l in pairs(track.jkf) do table.sort(l, function(a, b) return a.t < b.t end) end
	return track
end

local function easeA(a, es, ed)
	if es == "Constant" then return (ed == "In" and 1) or (ed == "Out" and 0) or (a < 0.5 and 0 or 1) end
	if es == "CubicV2" then es = "Cubic" end
	local ok, v = pcall(function()
		return TweenService:GetValue(math.clamp(a, 0, 1),
			Enum.EasingStyle[es] or Enum.EasingStyle.Linear, Enum.EasingDirection[ed] or Enum.EasingDirection.InOut)
	end)
	return ok and v or a
end

local function sampleJoint(l, tt, dur)
	local k1, k2
	for i = 1, #l do
		if l[i].t <= tt then k1 = l[i] else k2 = l[i]; break end
	end
	if k1 and k2 then return k1.cf:Lerp(k2.cf, easeA((tt - k1.t) / (k2.t - k1.t), k1.es, k1.ed)) end
	if k1 then
		local first = l[1]
		if first ~= k1 then
			local span = (dur - k1.t) + first.t
			if span > 1e-3 then return k1.cf:Lerp(first.cf, easeA((tt - k1.t) / span, k1.es, k1.ed)) end
		end
		return k1.cf
	end
	return k2 and k2.cf or CFrame.identity
end

playAnim = function(name)
	if mode == "mirror" and setMirror then setMirror(false) end
	stopTrack()
	autoState = nil;  danceState = nil
	proc = true
	local tr = animCache[name]
	if not tr then
		local data = httpGetBin(ANIM_BASE .. name .. ".anim")
		if not data then warn("[rig] anim fetch failed: " .. name); return end
		local ok, parsed = pcall(parseAnim, data)
		if not ok or type(parsed) ~= "table" or not next(parsed.jkf) then
			warn("[rig] anim parse failed: " .. name); return
		end
		tr = parsed;  animCache[name] = tr
	end
	animTrack, animStart = tr, os.clock()
	if piloting then pilotEmote = true end
	burstConfetti()
	print(("[rig] anim: %s  (%.1fs, %d joints)"):format(name, animTrack.dur, (function() local c = 0 for _ in pairs(animTrack.jkf) do c += 1 end return c end)()))
end
