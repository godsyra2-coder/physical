local EscalateEvent   = ReplicatedStorage.raidRoleplay.Events.EscalateEvent
local PartOwnership   = ReplicatedStorage.raidRoleplay.Modules.PartOwnership
local PropertyChanged = ReplicatedStorage:FindFirstChild("RemoteEvents") and ReplicatedStorage.RemoteEvents:FindFirstChild("PropertyChanged")

