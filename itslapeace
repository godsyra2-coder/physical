local function proceduralPose(dt)
	if not proc or spiderOn then return end
	dt = math.min(dt, 1 / 20)

	if animTrack then                                            -- real .anim keyframe playback
		local tt = (os.clock() - animStart) * animSpeed
		if animTrack.dur > 0 then tt = tt % animTrack.dur end
		local blend = math.min(dt * 16, 1)
		for _, r in ipairs(motorRec) do
			local l = animTrack.jkf[r.inst.Name]
			local cf = l and sampleJoint(l, tt, animTrack.dur) or ID
			cf = cf.Rotation + cf.Position * curScale
			r.inst.Transform = r.inst.Transform:Lerp(cf, blend)
		end
		if axisOvr then for jn, cf in pairs(axisOvr) do if joint[jn] then joint[jn].Transform = cf end end end
		return
	end

	pstT += dt
	local prate = 3.0
	if pstate == "walk" then prate = 5 + hum.WalkSpeed * 0.26
	elseif pstate == "run" then prate = 8 + hum.WalkSpeed * 0.32
	elseif pstate == "climb" then prate = 3.5 end
	walkPh += dt * prate

	local active, t = danceState or pstate, walkPh
	if not danceState and landT > 0 then landT -= dt;  active, t = "land", pstT end
	local p = (POSE[active] or POSE.idle)(t)

	--// sword: procedural hold + slash / lunge.  R6 right shoulder: +Z = arm forward/up, +X = across body, Y = blade twist
	if swordOn then
		local HOLD = math.rad(SWT.hold)                                       -- +72 -> arm forward, a bit above level
		local hL   = ang(0, 0, -math.rad(14))                                 -- left shoulder: -Z = off hand slightly forward
		local hR   = ang(math.rad(SWT.holdX), math.rad(SWT.twist), HOLD)      -- sword hand: forward, slight out + blade cant
		hR = hR * ang(0, math.sin(walkPh * 1.1) * math.rad(2), 0)             -- ready sway on the twist axis
		if swordAnim then
			swordAnimT += dt
			local k = math.clamp(swordAnimT / swordAnimDur, 0, 1)
			if swordAnim == "slash" then                                      -- overhead vertical chop
				local raise = ang(math.rad(SWT.holdX - 12), 0, math.rad(SWT.raise))   -- up & back over the shoulder
				local chop  = ang(math.rad(SWT.holdX + 6),  0, math.rad(SWT.chop))    -- swung down through to forward-low
				if k < 0.30 then hR = hR:Lerp(raise, k / 0.30)
				elseif k < 0.58 then hR = raise:Lerp(chop, (k - 0.30) / 0.28)
				else hR = chop:Lerp(hR, (k - 0.58) / 0.42) end
				p.root = p.root * ang(math.rad(k < 0.5 and -5 or 9), 0, 0)    -- coil back, then drive into the chop
			else -- lunge (forward thrust)
				local pull   = ang(0, math.rad(-8), math.rad(SWT.pull))       -- draw the blade back
				local thrust = ang(0, math.rad(-6), math.rad(SWT.thrust))     -- straight forward, horizontal
				if k < 0.22 then hR = hR:Lerp(pull, k / 0.22)
				elseif k < 0.48 then hR = pull:Lerp(thrust, (k - 0.22) / 0.26)
				else hR = thrust:Lerp(hR, (k - 0.48) / 0.52) end
				p.root = p.root * ang(math.rad(k < 0.5 and 4 or 11), 0, 0)
			end
			if k >= 1 then swordAnim = nil end
		end
		p.ls, p.rs = hL, hR
	end

	local a = math.min(dt * WALK.damp, 1)   -- exponential ease = the transition between poses
	joint["RootJoint"].Transform = joint["RootJoint"].Transform:Lerp(p.root, a)
	joint["Neck"].Transform      = joint["Neck"].Transform:Lerp(p.neck, a)
	local sa = swordAnim and math.min(dt * 22, 1) or a                             -- swings snap in faster
	joint["Left Shoulder"].Transform  = joint["Left Shoulder"].Transform:Lerp(p.ls, sa)
	joint["Right Shoulder"].Transform = joint["Right Shoulder"].Transform:Lerp(p.rs, sa)
	joint["Left Hip"].Transform  = joint["Left Hip"].Transform:Lerp(p.lh, a)
	joint["Right Hip"].Transform = joint["Right Hip"].Transform:Lerp(p.rh, a)

	if axisOvr then for jn, cf in pairs(axisOvr) do if joint[jn] then joint[jn].Transform = cf end end end
end
