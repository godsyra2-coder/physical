--// R6 Rig — drivable local puppet + server copy streamed via SyncMove
--//
--//  local  : real R6 rig (Motor6D joints + Humanoid + Animator), client-only.
--//  server : 6 F3X parts (CreatePart -> EscalateEvent claim -> props), anchored.
--//  bridge : every Heartbeat each local limb's world CFrame -> its server part via
--//           batched SyncMove, fire-and-forget (never waits on the reply).
--//
--//  IDLE mode  : rig stands beside you, GUI plays emotes, "Mirror" copies your pose.
--//  PILOT mode : YOU drive the rig — WASD walk, Shift run, Space jump, camera follows,
--//               animations auto-play from Humanoid state. Your real char is frozen.
--//
--//  (F3X spawns BaseParts only, so the server rig has no Humanoid — it just follows
--//   the local rig's pose frame by frame.)

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local UIS               = game:GetService("UserInputService")

local plr = Players.LocalPlayer
local cam = workspace.CurrentCamera

local playerControls   -- native movement controls -> GetMoveVector() (keyboard, thumbstick, gamepad)
pcall(function()
	local ps = plr:WaitForChild("PlayerScripts", 5)
	local pm = ps and ps:WaitForChild("PlayerModule", 5)
	if pm then playerControls = require(pm):GetControls() end
end)

--// ---------- Building Tools / remotes ----------
local function getBT()
	local c = workspace:FindFirstChild(plr.Name)
	if c then
		local b = c:FindFirstChild("Building Tools") or c:FindFirstChild("Building Tools Plus")
		if b then return b end
	end
	return plr.Backpack:FindFirstChild("Building Tools") or plr.Backpack:FindFirstChild("Building Tools Plus")
end
local bt = getBT()
assert(bt, "Building Tools not found (backpack or equipped)")

