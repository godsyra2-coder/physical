--// ---------- 4D-spinning tesseract wireframe above the head (client + server) ----------
do
	local THICK, PROJ, DIST = 0.06, 1.5, 2.6
	tessParts = {}

	--// 16 vertices (Â±1)^4, 32 edges (differ in exactly one coord)
	local V4 = {}
	for _, x in ipairs({ -1, 1 }) do for _, y in ipairs({ -1, 1 }) do
	for _, z in ipairs({ -1, 1 }) do for _, w in ipairs({ -1, 1 }) do V4[#V4 + 1] = { x, y, z, w } end end end end
	local E4 = {}
	for i = 1, 16 do for j = i + 1, 16 do
		local diff = 0
		for k = 1, 4 do if V4[i][k] ~= V4[j][k] then diff += 1 end end
		if diff == 1 then E4[#E4 + 1] = { i, j } end
	end end

	local tessHub = Instance.new("Part")
	tessHub.Name = "TessHub";  tessHub.Size = Vector3.new(0.05, 0.05, 0.05)
	tessHub.Transparency = 1;  tessHub.Anchored = true
	tessHub.CanCollide = false;  tessHub.CanQuery = false;  tessHub.CanTouch = false;  tessHub.CastShadow = false
	tessHub.Parent = localModel

	for n = 1, #E4 do
		local p = Instance.new("Part")
		p.Name = "TessEdge";  p.Size = Vector3.new(THICK, THICK, 1)
		p.Material = Enum.Material.Neon;  p.Color = tessColor()
		p.Anchored = true;  p.CanCollide = false;  p.CanQuery = false;  p.CanTouch = false
		p.Massless = true;  p.CastShadow = false;  p.Parent = tessHub
		tessParts[n] = { lp = p, a = E4[n][1], b = E4[n][2] }
	end

	--// rotate the 4D verts (XW + YZ planes), then perspective-project 4D -> 3D
	local proj = table.create(16)
	local function projectAll(ra, rb)
		local ca, sa, cb, sb = math.cos(ra), math.sin(ra), math.cos(rb), math.sin(rb)
		for idx = 1, 16 do
			local v = V4[idx]
			local x, y, z, w = v[1], v[2], v[3], v[4]
			local x2, w2 = x * ca - w * sa, x * sa + w * ca
			local y2, z2 = y * cb - z * sb, y * sb + z * cb
			local f = 1 / (DIST - w2)
			proj[idx] = Vector3.new(x2 * f, y2 * f, z2 * f) * PROJ
		end
	end

	local ra, rb = 0, 0
	RunService.RenderStepped:Connect(function(dt)
		if not alive or tessHidden then return end
		ra += dt * 0.9;  rb += dt * 0.55
		projectAll(ra, rb)
		local head = localParts.Head
		local hubCF = CFrame.new(head.Position + Vector3.new(0, head.Size.Y * 0.5 + 1.7, 0))
		tessHub.CFrame = hubCF
		for _, e in ipairs(tessParts) do
			local A, B = proj[e.a], proj[e.b]
			local d = B - A
			local len = d.Magnitude
			if len < 0.02 then len = 0.02; d = Vector3.new(0, 0, 0.02) end
			local up = math.abs(d.Unit.Y) > 0.99 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
			e.len = len
			e.lp.Size = Vector3.new(THICK, THICK, len)
			e.lp.CFrame = hubCF * CFrame.lookAt((A + B) * 0.5, (A + B) * 0.5 + d, up)
			e.lp.CastShadow = false
			if e.sp then e.sp.LocalTransparencyModifier = 1; e.sp.CastShadow = false end   -- hidden from yourself
		end
	end)

	--// server: the same 32 edges via F3X - 0.001 parts, length driven by a BlockMesh scale (keeps them micro)
	local TX = THICK * MESH_SCALE   -- thin-axis mesh scale (0.001 part * this = THICK)
	for n = 1, #E4 do
		task.spawn(function()
			local e = tessParts[n]
			local cf = e.lp.CFrame
			local p = ep:InvokeServer("CreatePart", "Normal", cf, workspace)
			if not p then return end
			EscalateEvent:FireServer(PartOwnership, { [1] = p })
			local t0 = os.clock()
			repeat task.wait(0.01) until p:FindFirstChild("RRPartOwner") or os.clock() - t0 > 5
			if not p:FindFirstChild("RRPartOwner") then return end
			ep:InvokeServer("SyncResize",    { [1] = { Part = p, Size = Vector3.new(MICRO, MICRO, MICRO), CFrame = cf } })
			ep:InvokeServer("SetName",       { p }, "TessEdge")
			ep:InvokeServer("SyncColor",     { [1] = { Part = p, Color = tessColor() } })
			ep:InvokeServer("SyncMaterial",  { [1] = { Part = p, Material = Enum.Material.Neon } })
			ep:InvokeServer("SyncCollision", { [1] = { Part = p, CanCollide = false } })
			ep:InvokeServer("CreateMeshes",  { [1] = { Part = p } })
			ep:InvokeServer("SyncMesh",      { [1] = { Part = p, MeshType = Enum.MeshType.Brick,
				Scale = Vector3.new(TX, TX, (e.len or 1) * MESH_SCALE) } })
			ep:InvokeServer("SyncAnchor",    { [1] = { Part = p, Anchored = true } })
			castShadowOff(p)
			e.sp = p
		end)
		task.wait(0.01)
	end

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		if not alive or tessHidden then return end
		acc += dt
		if acc < 1 / 30 then return end       -- 30 Hz
		acc = 0
		local mv, ms = {}, {}
		for _, e in ipairs(tessParts) do
			if e.sp then
				mv[#mv + 1] = { Part = e.sp, CFrame = e.lp.CFrame }
				ms[#ms + 1] = { Part = e.sp, Scale = Vector3.new(TX, TX, (e.len or 0.02) * MESH_SCALE) }
			end
		end
		if #mv > 0 then
			task.spawn(function() pcall(invoke, ep, "SyncMove", mv) end)
			task.spawn(function() pcall(invoke, ep, "SyncMesh", ms) end)
		end
	end)
end

