	spiderPushLook = function()
		task.spawn(function()
			local mat, col = {}, {}
			for _, m in ipairs(SMIRROR) do
				mat[#mat + 1] = { Part = m.sp, Material = m.lp.Material, Transparency = m.lp.Transparency }
				col[#col + 1] = { Part = m.sp, Color = m.lp.Color }
			end
			batched("SyncMaterial", mat)
			batched("SyncColor", col)
		end)
	end

