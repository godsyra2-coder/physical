--// 0 = off | 1 = hide the tesseract | 2 = also ghost the whole rig to 50% (harder to spot)
setSpy = function(lvl)
	spyLevel = lvl % 3
	local hideTess = spyLevel >= 1
	local ghost    = spyLevel >= 2
	tessHidden = hideTess

	if tessParts then
		for _, e in ipairs(tessParts) do
			e.lp.Transparency = hideTess and 1 or 0
			e.lp.CastShadow = false
		end
		task.spawn(function()
			local t = {}
			for _, e in ipairs(tessParts) do if e.sp then t[#t + 1] = { Part = e.sp, Transparency = hideTess and 1 or 0 } end end
			if #t > 0 then pcall(invoke, ep, "SyncMaterial", t) end
		end)
	end
	glow.Enabled = (not hideTess) and (SKINS[skinIdx].glow ~= nil)

	local baseT = SKINS[skinIdx].trans or 0
	local bodyT = ghost and 0.5 or baseT
	for _, s in ipairs(RIG) do
		if s.name ~= "HumanoidRootPart" then localParts[s.name].Transparency = bodyT end
	end
	if localSword then localSword.Transparency = swordOn and (ghost and 0.5 or 0) or 1 end
	task.spawn(function()
		local t = {}
		for _, sp in pairs(serverParts) do t[#t + 1] = { Part = sp, Transparency = bodyT } end
		if swordBlade and swordOn then t[#t + 1] = { Part = swordBlade, Transparency = ghost and 0.5 or 0 } end
		if #t > 0 then pcall(invoke, ep, "SyncMaterial", t) end
	end)

	if spyBtn then
		spyBtn.Text = ({ [0] = "Spy: Off", [1] = "Spy: On", [2] = "Spy: Max" })[spyLevel]
		spyBtn.BackgroundColor3 = spyLevel == 0 and Color3.fromRGB(46, 46, 56) or Color3.fromRGB(92, 74, 140)
	end
end
