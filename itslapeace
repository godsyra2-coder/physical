		  bsz=Vector3.new(4.4,1.5,5.4), hsz=Vector3.new(3.0,1.8,3.4), abdomen=true },

		{ name="Frost",   sp=1.45, w=0.4,  fem=4.0, tib=5.2, reach=7.6, bh=3.8, sw=0.42, lift=2.0, grate=0.09, gbob=0.1,
