local function resolveAnimId(cat)
	local animate = plr.Character and plr.Character:FindFirstChild("Animate")
	if animate then
		local folder = animate:FindFirstChild(cat)
		if folder then
			for _, ch in ipairs(folder:GetChildren()) do
				if ch:IsA("Animation") and ch.AnimationId ~= "" then return ch.AnimationId end
			end
		end
	end
	return FALLBACK[cat] or FALLBACK.idle
end

--// sword anims outrank everything else. hold pose (toolnone) is a persistent overlay
--// at Action2 so it owns the arms over walk/idle; swings punch through at Action4.
local PRIORITY = {
	toolslash = Enum.AnimationPriority.Action4,
	toollunge = Enum.AnimationPriority.Action4,
}

local function stopTrack()
	if currentTrack then currentTrack:Stop(0.15); currentTrack = nil end
	animTrack = nil
end

local function playCore(cat)
	stopTrack()
	if cat == "stop" then return end
	local tr = trackCache[cat]
	if not tr then
		local a = Instance.new("Animation")
		a.AnimationId = resolveAnimId(cat)
		local ok, res = pcall(function() return animator:LoadAnimation(a) end)
		if not ok then warn("[rig] load failed:", cat, res); return end
		tr = res;  trackCache[cat] = tr
	end
	if PRIORITY[cat] then tr.Priority = PRIORITY[cat] end
	tr.Looped = not ONESHOT[cat]
	tr:Play(0.12)
	currentTrack = tr
end

local function autoAnim(cat)          -- pilot: state-driven
	if autoState == cat then return end
	autoState = cat
	playCore(cat)
end

local function setMirror(on)
	if on then
		mode = "mirror"; stopTrack()
		for _, s in ipairs(RIG) do localParts[s.name].Anchored = true end
	else
		mode = "anim"
		for _, s in ipairs(RIG) do
			localParts[s.name].Anchored = (s.name == "HumanoidRootPart")
		end
	end
end

local CONFETTI_CATS = { wave = true, point = true, laugh = true, cheer = true, dance = true, dance2 = true, dance3 = true }
local function playCat(cat)            -- GUI emote button (works while piloting too)
	if mode == "mirror" then setMirror(false); if mirrorBtn then end end
	autoState = nil
	danceState = nil
	if setProc then setProc(false) end
	playCore(cat)
	if CONFETTI_CATS[cat] then burstConfetti() end
	if piloting then
		pilotEmote = (cat ~= "stop")
		if pilotEmote and ONESHOT[cat] then                 -- wave/point/laugh/jump: auto-resume after it ends
			local L = (currentTrack and currentTrack.Length) or 0
			if L <= 0 then L = 1.2 end
			task.delay(L, function() pilotEmote = false end)
		end
	end
end

