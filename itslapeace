		if not holdTrack then
			local a = Instance.new("Animation")
			a.AnimationId = resolveAnimId("toolnone")
			local ok, res = pcall(function() return animator:LoadAnimation(a) end)
			if ok and res then holdTrack = res end
		end
		if holdTrack then
			holdTrack.Priority = Enum.AnimationPriority.Action2
			holdTrack.Looped = true
			holdTrack:Play(0.2)
		end
	elseif holdTrack then
		holdTrack:Stop(0.2)
	end
	if swordBtn then
		swordBtn.BackgroundColor3 = on and Color3.fromRGB(70, 120, 160) or Color3.fromRGB(46, 46, 56)
	end
