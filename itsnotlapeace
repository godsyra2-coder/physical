	-- Apply Paint callback
	applyPaintButton.MouseButton1Click:Connect(function()
		if #activeSelectedParts == 0 then
			warn("⚠️ Select at least 1 part to apply paint!")
			return
		end
		
		local paintType = paintDropdown.Text:gsub(" ▼", "")
		
		for _, part in ipairs(activeSelectedParts) do
			if part and part.Parent then
				replicateToServer(function()
					setNetworkOwnership(part)
					
					if paintType == "Slippery" then
						part.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.01, 0, 1, 1)
					elseif paintType == "Bouncy" then
						part.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0, 2, 1, 1)
					elseif paintType == "Magnetic" then
						-- Check if universal magnet (black or medium stone grey)
						local isUniversal = false
						local partColor = part.Color
						if (math.abs(partColor.R - 27/255) < 0.01 and math.abs(partColor.G - 42/255) < 0.01 and math.abs(partColor.B - 53/255) < 0.01) or
						   (math.abs(partColor.R - 163/255) < 0.01 and math.abs(partColor.G - 162/255) < 0.01 and math.abs(partColor.B - 165/255) < 0.01) then
							isUniversal = true
						end
						
						local attachment = Instance.new("Attachment")
						attachment.Parent = part
						
						local alignPosition = Instance.new("AlignPosition")
						alignPosition.Attachment0 = attachment
						alignPosition.Mode = Enum.PositionAlignmentMode.OneAttachment
						alignPosition.MaxForce = 500
						alignPosition.Responsiveness = 10
						alignPosition.Parent = part
						
						part:SetAttribute("MagnetType", isUniversal and "Universal" or "Normal")
						part:SetAttribute("IsMagnetic", true)
						
						print("🧲 Applied Magnetic paint to", part.Name, isUniversal and "(Universal Magnet)" or "")
					elseif paintType == "Gooey" then
						part.CustomPhysicalProperties = PhysicalProperties.new(2, 10, 0, 1, 1)
					elseif paintType == "Water" then
						part.CustomPhysicalProperties = PhysicalProperties.new(0.3, 0, 0, 1, 1)
						part.Transparency = 0.5
					elseif paintType == "Buoyancy" then
						local attachment = Instance.new("Attachment")
						attachment.Parent = part
						
						local vectorForce = Instance.new("VectorForce")
						vectorForce.Attachment0 = attachment
						vectorForce.Force = Vector3.new(0, part.Mass * workspace.Gravity * 1.2, 0)
						vectorForce.RelativeTo = Enum.ActuatorRelativeTo.World
						vectorForce.Parent = part
					elseif paintType == "No Lost Energy" then
						part.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0, 1, 1, 1)
					elseif paintType == "No Lost Energy (Normal)" then
						part.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.3, 0.5, 1, 1)
					end
					
					print("🎨 Applied", paintType, "paint to", part.Name)
				end)
			end
		end
		
		print("🎨 Applied paint to", #activeSelectedParts, "parts")
	end)
	
