					ColorSequenceKeypoint.new(0, Color3.fromRGB(120, 120, 120)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(80, 80, 80))
				}
			end
			
			ownershipStatusLabel.Text = "Claimed: " .. ownershipClaimedCount .. " parts (Stopped)"
			
			-- Disconnect monitoring
			if ownershipConnection then
				ownershipConnection:Disconnect()
				ownershipConnection = nil
			end
			
			print("👑 Auto Ownership DISABLED")
		end
	end)
	
	-- Claim All Existing Parts Button Handler
	local claimAllDebounce = false
	claimAllBtn.MouseButton1Click:Connect(function()
		if claimAllDebounce then return end
		claimAllDebounce = true
		
		-- Change button to processing state
		claimAllBtnLabel.Text = "⚡ PROCESSING..."
		claimAllBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
		local gradient = claimAllBtn:FindFirstChildOfClass("UIGradient")
		if gradient then
			gradient.Color = ColorSequence.new{
				ColorSequenceKeypoint.new(0, Color3.fromRGB(100, 255, 100)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(50, 200, 50))
			}
		end
		
		task.spawn(function()
			-- Collect all BaseParts in workspace (INCLUDING parts with RRPartOwner)
			local allParts = {}
			for _, descendant in ipairs(workspace:GetDescendants()) do
				if descendant:IsA("BasePart") then
					-- Skip player's character parts
					local skipPart = false
					if chr then
						for _, charPart in ipairs(chr:GetDescendants()) do
							if descendant == charPart then
								skipPart = true
								break
							end
						end
					end
					
					-- Skip grass if safeguard enabled
					if not skipPart and state.safeguardEnabled and (descendant.Name == "Grass" or descendant.Name:find("Grass")) then
						skipPart = true
					end
					
					-- INCLUDE parts with RRPartOwner (already owned by other players)
					-- The group/ungroup exploit will steal ownership from them
					if not skipPart then
						table.insert(allParts, descendant)
					end
				end
			end
			
			local totalParts = #allParts
			local claimedCount = 0
			print(string.format("🎯 Claiming %d parts (including parts with RRPartOwner)", totalParts))
			
			print(string.format("🚀 TURBO CLAIM: Processing %d parts in batches of 20...", totalParts))
			
			-- Get F3X endpoint
			local serverEndpoint = getServerEndpoint()
			if not serverEndpoint then
				claimAllBtnLabel.Text = "❌ F3X NOT EQUIPPED!"
				task.wait(2)
				claimAllBtnLabel.Text = "⚡ CLAIM ALL EXISTING PARTS NOW"
				claimAllBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 200)
				if gradient then
					gradient.Color = ColorSequence.new{
						ColorSequenceKeypoint.new(0, Color3.fromRGB(200, 100, 255)),
						ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 50, 200))
					}
				end
				claimAllDebounce = false
				return
			end
			
			-- Split into batches of 20 parts
			local batchSize = 20
			local batches = {}
			for i = 1, totalParts, batchSize do
				local batch = {}
				for j = i, math.min(i + batchSize - 1, totalParts) do
					table.insert(batch, allParts[j])
				end
				table.insert(batches, batch)
			end
			
			local totalBatches = #batches
			local claimedCount = 0
			
			print(string.format("🚀 Created %d batches of up to 20 parts", totalBatches))
			claimAllBtnLabel.Text = string.format("⚡ PROCESSING %d BATCHES...", totalBatches)
			
			-- Fire ALL batches at the same time (parallel processing like steal mode)
			for batchIndex, batch in ipairs(batches) do
				task.spawn(function()
					-- Group this batch
					local success, model = pcall(function()
						return serverEndpoint:InvokeServer("CreateGroup", "Model", workspace, batch)
					end)
					
					if success and model then
						-- Small delay to let server process
						task.wait(0.05)
						
						-- Ungroup to claim ownership
						local ungroupSuccess = pcall(function()
							serverEndpoint:InvokeServer("Ungroup", {model})
						end)
						
						if ungroupSuccess then
							-- Unlock all parts in this batch
							for _, part in ipairs(batch) do
								if part and part.Parent then
									pcall(function()
										part.Locked = false
									end)
								end
							end
							
							claimedCount = claimedCount + #batch
							
							-- Update status every few batches
							if batchIndex % 5 == 0 or batchIndex == totalBatches then
								claimAllBtnLabel.Text = string.format("⚡ CLAIMED: %d/%d", claimedCount, totalParts)
							end
							
							print(string.format("✅ Batch %d/%d: Claimed %d parts", batchIndex, totalBatches, #batch))
						else
							print(string.format("❌ Batch %d: Ungroup failed", batchIndex))
						end
					else
						print(string.format("❌ Batch %d: Group failed", batchIndex))
					end
				end)
			end
			
			-- Wait for all batches to complete (estimate based on batch count)
			task.wait(math.max(2, totalBatches * 0.1))
			
			-- Show completion
			claimAllBtnLabel.Text = string.format("✓ CLAIMED %d PARTS!", claimedCount)
			claimAllBtn.BackgroundColor3 = Color3.fromRGB(100, 200, 255)
			if gradient then
				gradient.Color = ColorSequence.new{
					ColorSequenceKeypoint.new(0, Color3.fromRGB(150, 255, 150)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(100, 200, 100))
				}
			end
			
			print(string.format("👑 TURBO CLAIM COMPLETE: %d/%d parts claimed!", claimedCount, totalParts))
			
			-- Reset button after 3 seconds
			task.wait(3)
			claimAllBtnLabel.Text = "⚡ CLAIM ALL EXISTING PARTS NOW"
			claimAllBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 200)
			if gradient then
				gradient.Color = ColorSequence.new{
					ColorSequenceKeypoint.new(0, Color3.fromRGB(200, 100, 255)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 50, 200))
				}
			end
			claimAllDebounce = false
		end)
	end)
	
	print("✓ Part Stealer panel created with full functionality")
end

