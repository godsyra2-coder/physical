	local serverEndpoint = syncAPI:FindFirstChild("ServerEndpoint")
	if not serverEndpoint then
		warn("⚠️ ServerEndpoint not found!")
		GUI.ungroupLabel.Text = "NO ENDPOINT!"
		GUI.ungroupButton.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
		task.wait(1.5)
		GUI.ungroupLabel.Text = "UNGROUP"
		GUI.ungroupButton.BackgroundColor3 = Color3.fromRGB(80, 140, 220)
		state.ungroupDebounce = false
		return
	end
	
	-- Step 1: Create dummy part way up in the sky
	print("🔨 Creating dummy part...")
	GUI.ungroupLabel.Text = "CREATING DUMMY..."
	local dummyPart
	local createSuccess = pcall(function()
		dummyPart = serverEndpoint:InvokeServer("CreatePart", "Normal", CFrame.new(0, 900000000000000000000, 0), workspace)
	end)
	
	if not createSuccess or not dummyPart then
		warn("⚠️ Failed to create dummy part!")
		GUI.ungroupLabel.Text = "CREATE FAILED!"
		GUI.ungroupButton.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
		task.wait(1.5)
		GUI.ungroupLabel.Text = "UNGROUP"
		GUI.ungroupButton.BackgroundColor3 = Color3.fromRGB(80, 140, 220)
		state.ungroupDebounce = false
		return
	end
	
	print("✅ Created dummy part:", dummyPart:GetFullName())
	task.wait(0.05)
	
	-- Step 2: Group the dummy part with the target
	print("📦 Grouping dummy with target...")
	GUI.ungroupLabel.Text = "GROUPING..."
	local groupSuccess = pcall(function()
		serverEndpoint:InvokeServer("CreateGroup", "Model", workspace, {dummyPart, target})
	end)
	
	if not groupSuccess then
		warn("⚠️ Failed to group parts!")
		pcall(function() serverEndpoint:InvokeServer("Remove", {dummyPart}) end)
		GUI.ungroupLabel.Text = "GROUP FAILED!"
		GUI.ungroupButton.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
		task.wait(1.5)
		GUI.ungroupLabel.Text = "UNGROUP"
		GUI.ungroupButton.BackgroundColor3 = Color3.fromRGB(80, 140, 220)
		state.ungroupDebounce = false
		return
	end
	
	print("✅ Grouped parts")
	task.wait(0.05)
	
	-- Step 3: Ungroup to claim ownership
	print("📤 Ungrouping to steal ownership...")
	GUI.ungroupLabel.Text = "UNGROUPING..."
	local ungroupSuccess = pcall(function()
		serverEndpoint:InvokeServer("Ungroup", {target})
	end)
	
	if not ungroupSuccess then
		warn("⚠️ Failed to ungroup!")
		GUI.ungroupLabel.Text = "UNGROUP FAILED!"
		GUI.ungroupButton.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
		task.wait(1.5)
		GUI.ungroupLabel.Text = "UNGROUP"
		GUI.ungroupButton.BackgroundColor3 = Color3.fromRGB(80, 140, 220)
		state.ungroupDebounce = false
		return
	end
	
	print("✅ Ungrouped - waiting for RRPartOwner...")
	GUI.ungroupLabel.Text = "CLAIMING..."
	
	-- Step 4: Wait for RRPartOwner to be added
	local ownershipClaimed = false
	for i = 1, 50 do
		if target:FindFirstChild("RRPartOwner") then
			ownershipClaimed = true
			print("✅ RRPartOwner added - Part stolen!")
			break
		end
		task.wait(0.01)
	end
	
	if not ownershipClaimed then
		warn("⚠️ RRPartOwner not added - ownership claim may have failed")
	end
	
	-- Step 5: Remove dummy part
	print("🗑️ Cleaning up dummy part...")
	GUI.ungroupLabel.Text = "CLEANING..."
	pcall(function()
		if dummyPart and dummyPart.Parent then
			serverEndpoint:InvokeServer("Remove", {dummyPart})
			print("✅ Dummy part removed")
		end
	end)
	
	print("🎉 Drop complete!")
	GUI.ungroupLabel.Text = "DROPPED!"
	GUI.ungroupButton.BackgroundColor3 = Color3.fromRGB(80, 200, 120)
	task.wait(1.5)
	GUI.ungroupLabel.Text = "UNGROUP"
	GUI.ungroupButton.BackgroundColor3 = Color3.fromRGB(80, 140, 220)
	state.ungroupDebounce = false
end

