					if union then
						task.wait(0.03) -- Optimized timing
						
						-- Step 3: Separate union - this gives us ownership
						serverEndpoint:InvokeServer("SeparateUnion", {union})
						
						-- Step 4: Unlock the part locally
						task.wait(0.1) -- Optimized timing
						pcall(function()
							part.Locked = false
						end)
						
						success = true
					end
				end)
				
				return success
			end
			
			-- Execute steal
			local success = stealPartExact(object)
			
