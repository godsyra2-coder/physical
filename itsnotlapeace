	-- BATCH PROCESSOR - Process multiple parts at once for MAXIMUM SPEED
	local function processBatch()
		if batchProcessing or #partQueue == 0 then return end
		batchProcessing = true
		
		task.spawn(function()
			while #partQueue > 0 and autoOwnershipEnabled do
				-- Take up to 50 parts at once for batch processing
				local batch = {}
				for i = 1, math.min(50, #partQueue) do
					table.insert(batch, table.remove(partQueue, 1))
				end
				
				-- Process entire batch in parallel
				for _, part in ipairs(batch) do
					task.spawn(function()
						if not part or not part.Parent then return end
						
						local serverEndpoint = getServerEndpoint()
						if not serverEndpoint then return end
						
						-- Fire and forget - don't wait for response
						pcall(function()
							local union = serverEndpoint:InvokeServer("CreateUnion", {part})
							if union then
								serverEndpoint:InvokeServer("SeparateUnion", {union})
								part.Locked = false
								ownershipClaimedCount = ownershipClaimedCount + 1
								ownershipStatusLabel.Text = "Claimed: " .. ownershipClaimedCount .. " parts"
							end
						end)
					end)
				end
				
				-- Tiny delay between batches to prevent server throttling
				task.wait(0.05)
			end
			
			batchProcessing = false
		end)
	end
	
	-- Fast claim function - just adds to queue
	local function claimOwnership(part)
		if not part or not part.Parent or not part:IsA("BasePart") then
			return false
		end
		
		-- Skip player's character parts
		if chr then
			for _, charPart in ipairs(chr:GetDescendants()) do
				if part == charPart then
					return false
				end
			end
		end
		
		-- Skip grass if safeguard enabled
		if state.safeguardEnabled and (part.Name == "Grass" or part.Name:find("Grass")) then
			return false
		end
		
		-- Add to queue for batch processing
		table.insert(partQueue, part)
		
		-- Start batch processor if not running
		if not batchProcessing then
			processBatch()
		end
		
		return true
	end
	
