	-- Apply Gyro callback (uses global gyroStabilizers table)
	applyGyroButton.MouseButton1Click:Connect(function()
		if #activeSelectedParts == 0 then
			warn("⚠️ Select at least 1 part to apply gyro!")
			return
		end
		
		local orientation = gyroOrientationDropdown.Text:gsub(" ▼", "")
		local gyroType = gyroTypeDropdown.Text:gsub(" ▼", "")
		local power = math.clamp(tonumber(gyroPowerInput.Text) or 50, 0, 100)
		local level = tonumber(gyroLevelInput.Text) or 1
		
		for _, part in ipairs(activeSelectedParts) do
			if part and part.Parent then
				replicateToServer(function()
					setNetworkOwnership(part)
					
					-- Remove existing gyro if present
					if gyroStabilizers[part] then
						pcall(function()
							if gyroStabilizers[part].connection then gyroStabilizers[part].connection:Disconnect() end
							if gyroStabilizers[part].bodyPosition then gyroStabilizers[part].bodyPosition:Destroy() end
							if gyroStabilizers[part].bodyAngularVelocity then gyroStabilizers[part].bodyAngularVelocity:Destroy() end
							if gyroStabilizers[part].attachment then gyroStabilizers[part].attachment:Destroy() end
							if gyroStabilizers[part].alignOrientation then gyroStabilizers[part].alignOrientation:Destroy() end
							if gyroStabilizers[part].bodyGyro then gyroStabilizers[part].bodyGyro:Destroy() end
						end)
					end
					
					local originalCFrame = part.CFrame
					local connection = nil
					local bodyPosition, bodyGyro, alignOrientation, attachment
					
					if gyroType == "BodyPosition" then
						bodyPosition = Instance.new("BodyPosition")
						bodyPosition.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
						bodyPosition.Position = part.Position
						bodyPosition.D = 5000 * (power / 50)
						bodyPosition.P = 50000 * (power / 50)
						bodyPosition.Parent = part
						
						connection = RunService.Heartbeat:Connect(function()
							if not part.Parent then connection:Disconnect() return end
							
							local targetCFrame
							if orientation == "Upright" then
								targetCFrame = CFrame.new(part.Position) * CFrame.Angles(0, originalCFrame:ToEulerAnglesXYZ(), 0)
							elseif orientation == "Level" then
								local _, yaw, _ = originalCFrame:ToEulerAnglesXYZ()
								targetCFrame = CFrame.new(part.Position) * CFrame.Angles(0, yaw, 0)
							elseif orientation == "Original" then
								targetCFrame = originalCFrame
							elseif orientation == "VelocityAligned" then
								local vel = part.AssemblyLinearVelocity
								if vel.Magnitude > 0.1 then
									targetCFrame = CFrame.lookAt(part.Position, part.Position + vel)
								else
									targetCFrame = originalCFrame
								end
							end
							
							part.CFrame = part.CFrame:Lerp(targetCFrame, 0.1 * level)
							bodyPosition.Position = part.Position
						end)
						
						gyroStabilizers[part] = {bodyPosition = bodyPosition, connection = connection}
						
					elseif gyroType == "AlignOrientation" then
						attachment = Instance.new("Attachment")
						attachment.Parent = part
						
						alignOrientation = Instance.new("AlignOrientation")
						alignOrientation.Attachment0 = attachment
						alignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
						alignOrientation.Responsiveness = 10 * (power / 50) * level
						alignOrientation.MaxTorque = 10000 * (power / 50)
						alignOrientation.Parent = part
						
						connection = RunService.Heartbeat:Connect(function()
							if not part.Parent then connection:Disconnect() return end
							
							if orientation == "Upright" then
								local _, yaw, _ = part.CFrame:ToEulerAnglesXYZ()
								alignOrientation.CFrame = CFrame.Angles(0, yaw, 0)
							elseif orientation == "Level" then
								local _, yaw, _ = part.CFrame:ToEulerAnglesXYZ()
								alignOrientation.CFrame = CFrame.Angles(0, yaw, 0)
							elseif orientation == "Original" then
								alignOrientation.CFrame = originalCFrame - originalCFrame.Position
							elseif orientation == "VelocityAligned" then
								local vel = part.AssemblyLinearVelocity
								if vel.Magnitude > 0.1 then
									alignOrientation.CFrame = CFrame.lookAt(Vector3.new(0, 0, 0), vel)
								else
									alignOrientation.CFrame = originalCFrame - originalCFrame.Position
								end
							end
						end)
						
						gyroStabilizers[part] = {alignOrientation = alignOrientation, attachment = attachment, connection = connection}
						
					elseif gyroType == "BodyGyro" then
						bodyGyro = Instance.new("BodyGyro")
						bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
						bodyGyro.P = 50000 * (power / 50)
						bodyGyro.D = 5000 * (power / 50)
						bodyGyro.Parent = part
						
						connection = RunService.Heartbeat:Connect(function()
							if not part.Parent then connection:Disconnect() return end
							
							if orientation == "Upright" then
								local _, yaw, _ = part.CFrame:ToEulerAnglesXYZ()
								bodyGyro.CFrame = CFrame.new(part.Position) * CFrame.Angles(0, yaw, 0)
							elseif orientation == "Level" then
								local _, yaw, _ = part.CFrame:ToEulerAnglesXYZ()
								bodyGyro.CFrame = CFrame.new(part.Position) * CFrame.Angles(0, yaw, 0)
							elseif orientation == "Original" then
								bodyGyro.CFrame = originalCFrame
							elseif orientation == "VelocityAligned" then
								local vel = part.AssemblyLinearVelocity
								if vel.Magnitude > 0.1 then
									bodyGyro.CFrame = CFrame.lookAt(part.Position, part.Position + vel)
								else
									bodyGyro.CFrame = originalCFrame
								end
							end
						end)
						
						gyroStabilizers[part] = {bodyGyro = bodyGyro, connection = connection}
					end
					
					print("⚙️ Applied Gyro Stabilizer to", part.Name, "(" .. orientation .. ", " .. gyroType .. ", Power=" .. power .. ", Level=" .. level .. ")")
				end)
			end
		end
		
		print("⚙️ Applied gyro to", #activeSelectedParts, "parts")
	end)
	
