-- Build Explorer Tree
local currentLayoutOrder = 0
local childrenContainers = {}

local function reorderAllNodes()
	-- Recursively reorder all visible nodes in proper hierarchy
	local order = 0
	local function reorderNode(node)
		if node.Visible then
			node.LayoutOrder = order
			order = order + 1
			
			local data = childrenContainers[node]
			if data and data.expanded then
				for _, childNode in ipairs(data.children) do
					reorderNode(childNode)
				end
			end
		end
	end
	
	-- Reorder all root nodes and their children
	for _, child in pairs(explorerScroll:GetChildren()) do
		if child:IsA("Frame") and child.Name:match("^Node_") then
			local data = childrenContainers[child]
			if data and data.depth == 0 then
				reorderNode(child)
			end
		end
	end
end

local function addNode(object, depth, parentNode)
	-- NO LIMITS - Unlimited depth and nodes
	
	-- Apply filter: skip Parts named "Part" if filter is enabled
	if filterPartsEnabled and object:IsA("Part") and object.Name == "Part" then
		return nil
	end
	
	-- Increment node counter
	explorerNodeCount = explorerNodeCount + 1
	
	currentLayoutOrder = currentLayoutOrder + 1
	local nodeFrame, expandButton, nameLabel, hasChildren = createExplorerNode(object, depth, currentLayoutOrder)
	nodeFrame.Parent = explorerScroll
	nodeFrame.Visible = (depth == 0) -- Only show root nodes initially
	
	-- Track children for this node
	local childrenList = {}
	childrenContainers[nodeFrame] = {
		expanded = false, 
		children = childrenList, 
		childrenBuilt = false,
		object = object, 
		depth = depth,
		parent = parentNode
	}
	
	-- Expand/Collapse functionality
	if hasChildren then
		expandButton.MouseButton1Click:Connect(function()
			-- Don't allow expansion during search
			if searchBar.Text ~= "" then
				print("⚠ Clear search to expand nodes")
				return
			end
			
			local nodeData = childrenContainers[nodeFrame]
			nodeData.expanded = not nodeData.expanded
			expandButton.Text = nodeData.expanded and "-" or "+"
			
			if nodeData.expanded then
				-- Build children if not already built
				if not nodeData.childrenBuilt then
					nodeData.childrenBuilt = true
					local children = object:GetChildren()
					
					-- Sort children: Terrain first, Camera last, then alphabetically
					table.sort(children, function(a, b)
						local aIsTerrain = a.Name == "Terrain"
						local bIsTerrain = b.Name == "Terrain"
						local aIsCamera = a.Name == "Camera"
						local bIsCamera = b.Name == "Camera"
						
						if aIsTerrain then return true end
						if bIsTerrain then return false end
						if aIsCamera then return false end
						if bIsCamera then return true end
						
						return a.Name:lower() < b.Name:lower()
					end)
					
					-- Build ALL children in PARALLEL
					for i, child in ipairs(children) do
						task.spawn(function()
							local childNode = addNode(child, depth + 1, nodeFrame)
							if childNode then
								table.insert(nodeData.children, childNode)
							end
						end)
					end
				end
				
				-- Show immediate children only
				for _, childNode in ipairs(nodeData.children) do
					childNode.Visible = true
				end
			else
				-- Hide all children recursively
				local function hideChildren(node)
					local data = childrenContainers[node]
					if data then
						for _, childNode in ipairs(data.children) do
							childNode.Visible = false
							-- Collapse and hide their children too
							if data.expanded then
								data.expanded = false
								local childExpandBtn = childNode:FindFirstChild("ExpandButton")
								if childExpandBtn then
									childExpandBtn.Text = "+"
								end
							end
							hideChildren(childNode)
						end
					end
				end
				hideChildren(nodeFrame)
			end
			
			-- Reorder all nodes to maintain hierarchy
			reorderAllNodes()
			
			-- Update canvas size
			task.wait()
			local contentSize = explorerLayout.AbsoluteContentSize.Y
			explorerScroll.CanvasSize = UDim2.new(0, 0, 0, contentSize)
		end)
	end
	
	-- Selection functionality
	nameLabel.MouseButton1Click:Connect(function()
		local obj = state.nodeObjects[nodeFrame]
		
		-- Update global selectedObject for MOVER tab
		selectedObject = obj
		state.selectedObject = obj
		
		if state.explorerSelectionMode == "target" then
			state.targetObject = obj
			targetExplorerButton.Text = "SELECT FROM EXPLORER"
			targetExplorerButton.BackgroundColor3 = Color3.fromRGB(70, 130, 200)
			state.explorerSelectionMode = nil
			print("✓ Target selected:", obj.Name)
			updateDisplay()
		else
			-- Just selecting for MOVER or other purposes
			print("✓ Object selected:", obj.Name)
		end
	end)
	
	-- Hover effect (Aero blue highlight)
	nameLabel.MouseEnter:Connect(function()
		nodeFrame.BackgroundColor3 = Color3.fromRGB(220, 235, 250)
	end)
	nameLabel.MouseLeave:Connect(function()
		nodeFrame.BackgroundColor3 = Color3.fromRGB(248, 250, 252)
	end)
	
	return nodeFrame
end

local function buildExplorerTree()
	-- CRASH PREVENTION: Debounce rapid rebuilds
	if state.updateDebounce then
		warn("⚠️ Tree rebuild already in progress, skipping...")
		return
	end
	
	state.updateDebounce = true
	print("Building explorer tree...")
	
	-- Reset node counter
	explorerNodeCount = 0
	
	-- Save expanded state before clearing
	local expandedPaths = {}
	for nodeFrame, data in pairs(childrenContainers) do
		if data.expanded then
			local obj = data.object
			if obj and obj.Parent then
				pcall(function()
					expandedPaths[obj:GetFullName()] = true
				end)
			end
		end
	end
	
	-- Disconnect all previous update connections to prevent memory leaks
	for _, connection in pairs(state.updateConnections) do
		pcall(function()
			if connection then
				connection:Disconnect()
			end
		end)
	end
	state.updateConnections = {}
	
	-- Clear existing
	for _, child in pairs(explorerScroll:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	
	state.nodeObjects = {}
	childrenContainers = {}
	currentLayoutOrder = 0
	
	-- Add main services
	local services = {
		game:GetService("Workspace"),
		game:GetService("ReplicatedStorage"),
		game:GetService("ReplicatedFirst"),
		game:GetService("Lighting"),
		game:GetService("Players"),
		game:GetService("StarterGui"),
		game:GetService("StarterPack"),
		game:GetService("StarterPlayer")
	}
	
	-- Function to find node frame for an object
	local function findNodeForObject(obj)
		for nodeFrame, nodeObj in pairs(state.nodeObjects) do
			if nodeObj == obj then
				return nodeFrame
			end
		end
		return nil
	end
	
	-- Function to remove a node and its children
	local function removeNodeAndChildren(nodeFrame)
		local data = childrenContainers[nodeFrame]
		if data then
			-- Recursively remove children
			for _, childNode in ipairs(data.children) do
				removeNodeAndChildren(childNode)
			end
		end
		
		-- Clean up references
		state.nodeObjects[nodeFrame] = nil
		childrenContainers[nodeFrame] = nil
		
		-- Destroy the frame
		if nodeFrame and nodeFrame.Parent then
			nodeFrame:Destroy()
		end
	end
	
	-- Function to setup monitoring on an object and its descendants
	local function setupMonitoring(object, recursive)
		-- Monitor ChildAdded
		local addedConn = object.ChildAdded:Connect(function(child)
			if state.updateDebounce then return end
			state.updateDebounce = true
			
			-- Removed print to prevent console spam
			
			task.wait(0.1) -- Small delay to batch changes
			
			-- Find parent node
			local parentNode = findNodeForObject(object)
			if parentNode then
				local parentData = childrenContainers[parentNode]
				if parentData and parentData.expanded then
					-- Parent is expanded, add the new child node (filter will be applied in addNode)
					local childNode = addNode(child, parentData.depth + 1, parentNode)
					if childNode then
						table.insert(parentData.children, childNode)
						childNode.Visible = true
						
						-- Note: Automatic monitoring disabled - use Refresh button to update tree
						
						-- Reorder nodes
						reorderAllNodes()
						
						-- Update expand button visibility
						local expandBtn = parentNode:FindFirstChild("ExpandButton")
						if expandBtn then
							expandBtn.Visible = true
						end
					end
				end
				-- Note: Automatic monitoring disabled - use Refresh button to update tree
			end
			
			state.updateDebounce = false
		end)
		table.insert(state.updateConnections, addedConn)
		
		-- Monitor ChildRemoved
		local removedConn = object.ChildRemoved:Connect(function(child)
			if state.updateDebounce then return end
			state.updateDebounce = true
			
			-- Removed print to prevent console spam
			
			task.wait(0.1) -- Small delay to batch changes
			
			-- Find and remove the node for this child
			local childNode = findNodeForObject(child)
			if childNode then
				removeNodeAndChildren(childNode)
			end
			
			-- Check if parent still has children
			local parentNode = findNodeForObject(object)
			if parentNode then
				local parentData = childrenContainers[parentNode]
				if parentData then
					-- Update children list
					local newChildren = {}
					for _, node in ipairs(parentData.children) do
						if node.Parent then
							table.insert(newChildren, node)
						end
					end
					parentData.children = newChildren
					
					-- Hide expand button if no children left
					if #object:GetChildren() == 0 then
						local expandBtn = parentNode:FindFirstChild("ExpandButton")
						if expandBtn then
							expandBtn.Visible = false
						end
					end
				end
			end
			
			-- Reorder remaining nodes
			reorderAllNodes()
			
			state.updateDebounce = false
		end)
		table.insert(state.updateConnections, removedConn)
		
		-- Recursively monitor existing children only if recursive flag is true
		if recursive then
			local count = 0
			for _, child in ipairs(object:GetChildren()) do
				pcall(function()
					setupMonitoring(child, true)
				end)
				count = count + 1
				if count % 50 == 0 then task.wait() end -- Yield every 50 items
			end
		end
	end
	
	-- Setup monitoring on all services with full recursion - DISABLED FOR PERFORMANCE
	-- Monitoring is now done only when nodes are expanded
	-- for _, service in ipairs(services) do
	-- 	pcall(function()
	-- 		setupMonitoring(service, true)
	-- 	end)
	-- end
	
	-- Build tree in PARALLEL - ONLY WORKSPACE for speed (others load on expand)
	-- Only show Workspace initially, other services are added but collapsed
	for i, service in ipairs(services) do
		if service.Name == "Workspace" then
			-- Load Workspace immediately (visible)
			task.spawn(function()
				addNode(service, 0, nil)
			end)
		else
			-- Add other services but don't load children yet (faster)
			task.spawn(function()
				local node = createExplorerNode(service, 0, i)
				node.Parent = explorerScroll
				node.Visible = true
				
				state.nodeObjects[node] = service
				childrenContainers[node] = {
					expanded = false,
					children = {},
					childrenBuilt = false,
					object = service,
					depth = 0,
					parent = nil
				}
				
				-- Setup expand button to load children on click
				local expandBtn = node:FindFirstChild("ExpandButton")
				if expandBtn then
					expandBtn.MouseButton1Click:Connect(function()
						local nodeData = childrenContainers[node]
						nodeData.expanded = not nodeData.expanded
						expandBtn.Text = nodeData.expanded and "-" or "+"
						
						if nodeData.expanded and not nodeData.childrenBuilt then
							nodeData.childrenBuilt = true
							for _, child in ipairs(service:GetChildren()) do
								task.spawn(function()
									local childNode = addNode(child, 1, node)
									if childNode then
										table.insert(nodeData.children, childNode)
										childNode.Visible = true
									end
								end)
							end
						else
							for _, childNode in ipairs(nodeData.children) do
								childNode.Visible = nodeData.expanded
							end
						end
						
						reorderAllNodes()
					end)
				end
			end)
		end
	end
	
	-- Update canvas size (faster)
	task.wait(0.05) -- Reduced from default
	local contentSize = explorerLayout.AbsoluteContentSize.Y
	explorerScroll.CanvasSize = UDim2.new(0, 0, 0, contentSize)
	
	print("✓ Explorer tree built! (Fast mode - only Workspace loaded)")
	
	-- Restore expanded state recursively
	if next(expandedPaths) then
		print("Restoring expanded nodes...")
		
		-- Function to recursively expand a node and its children
		local function expandNodeRecursive(nodeFrame, data)
			if not data or not data.object then return end
			
			local obj = data.object
			if expandedPaths[obj:GetFullName()] then
				-- Manually expand this node
				data.expanded = true
				local expandBtn = nodeFrame:FindFirstChild("ExpandButton")
				if expandBtn then
					expandBtn.Text = "-"
				end
				
				-- Build children if not already built
				if not data.childrenBuilt then
					data.childrenBuilt = true
					local children = obj:GetChildren()
					
					-- Sort children: Terrain first, Camera last, then alphabetically
					table.sort(children, function(a, b)
						local aIsTerrain = a.Name == "Terrain"
						local bIsTerrain = b.Name == "Terrain"
						local aIsCamera = a.Name == "Camera"
						local bIsCamera = b.Name == "Camera"
						
						if aIsTerrain then return true end
						if bIsTerrain then return false end
						if aIsCamera then return false end
						if bIsCamera then return true end
						
						return a.Name:lower() < b.Name:lower()
					end)
					
					for i, child in ipairs(children) do
						local childNode = addNode(child, data.depth + 1, nodeFrame)
						if childNode then
							table.insert(data.children, childNode)
						end
					end
				end
				
				-- Show immediate children
				for _, childNode in ipairs(data.children) do
					childNode.Visible = true
					
					-- Recursively expand child nodes if they were expanded
					local childData = childrenContainers[childNode]
					if childData then
						expandNodeRecursive(childNode, childData)
					end
				end
			end
		end
		
		-- Start with root nodes (depth 0) and expand recursively
		for nodeFrame, data in pairs(childrenContainers) do
			if data.depth == 0 then
				expandNodeRecursive(nodeFrame, data)
			end
		end
		
		reorderAllNodes()
		print("✓ Expanded state restored!")
	end
	
	-- Re-apply search filter if there was one
	if searchBar.Text ~= "" then
		print("Re-applying search filter:", searchBar.Text)
		filterExplorer(searchBar.Text)
	end
	
	-- Reset debounce after a delay
	task.delay(config.DEBOUNCE_TIME, function()
		state.updateDebounce = false
		print("✓ Tree rebuild complete, debounce reset")
	end)
end

-- Search/Filter functionality
local function filterExplorer(searchText)
	searchText = searchText:lower()
	
	if searchText == "" then
		-- Reset to hierarchy view - only show root nodes and expanded children
		for _, child in pairs(explorerScroll:GetChildren()) do
			if child:IsA("Frame") and child.Name:match("^Node_") then
				local data = childrenContainers[child]
				if data then
					if data.depth == 0 then
						child.Visible = true
					else
						-- Check if parent chain is expanded
						local shouldShow = true
						local currentParent = data.parent
						while currentParent do
							local parentData = childrenContainers[currentParent]
							if not parentData or not parentData.expanded then
								shouldShow = false
								break
							end
							currentParent = parentData.parent
						end
						child.Visible = shouldShow
					end
				end
			end
		end
		reorderAllNodes()
		return
	end
	
	-- Filter nodes based on search - show all matches regardless of hierarchy
	local hasMatches = false
	for _, child in pairs(explorerScroll:GetChildren()) do
		if child:IsA("Frame") and child.Name:match("^Node_") then
			local obj = state.nodeObjects[child]
			if obj then
				local nameMatch = obj.Name:lower():find(searchText, 1, true)
				local classMatch = obj.ClassName:lower():find(searchText, 1, true)
				
				if nameMatch or classMatch then
					child.Visible = true
					hasMatches = true
				else
					child.Visible = false
				end
			end
		end
	end
	
	-- Reorder visible nodes
	if hasMatches then
		local order = 0
		for _, child in pairs(explorerScroll:GetChildren()) do
			if child:IsA("Frame") and child.Name:match("^Node_") and child.Visible then
				child.LayoutOrder = order
				order = order + 1
			end
		end
	end
end

