-- CUT function: Move object using ungroup mechanic
local function performMoverCut(sourceObj, destObj)
	print("✂️ CUT: Moving", sourceObj:GetFullName(), "to", destObj:GetFullName())
	
	-- Get Building Tools
	local buildingTools = player.Backpack:FindFirstChild("Building Tools") or player.Backpack:FindFirstChild("Building Tools Plus")
	if not buildingTools and chr then
		buildingTools = chr:FindFirstChild("Building Tools") or chr:FindFirstChild("Building Tools Plus")
	end
	
	if not buildingTools then
		warn("⚠️ Building Tools not found!")
		return false
	end
	
	local syncAPI = buildingTools:FindFirstChild("SyncAPI")
	if not syncAPI then
		warn("⚠️ SyncAPI not found!")
		return false
	end
	
	local serverEndpoint = syncAPI:FindFirstChild("ServerEndpoint")
	if not serverEndpoint then
		warn("⚠️ ServerEndpoint not found!")
		return false
	end
	
	-- Step 1: Create dummy part
	print("🔨 Creating dummy part...")
	local dummyPart
	local createSuccess = pcall(function()
		dummyPart = serverEndpoint:InvokeServer("CreatePart", "Normal", CFrame.new(0, 900000000000000000000, 0), workspace)
	end)
	
	if not createSuccess or not dummyPart then
		warn("⚠️ Failed to create dummy part!")
		return false
	end
	
	print("✅ Created dummy part:", dummyPart:GetFullName())
	task.wait(0.05)
	
	-- Step 2: Group dummy with source object
	print("📦 Grouping dummy with source...")
	local groupSuccess, groupModel = pcall(function()
		return serverEndpoint:InvokeServer("CreateGroup", "Model", workspace, {dummyPart, sourceObj})
	end)
	
	if not groupSuccess or not groupModel then
		warn("⚠️ Failed to group parts!")
		pcall(function() serverEndpoint:InvokeServer("Remove", {dummyPart}) end)
		return false
	end
	
	print("✅ Grouped - Model:", groupModel:GetFullName())
	task.wait(0.05)
	
	-- Step 3: Reparent the group to destination
	print("📍 Reparenting group to destination...")
	local reparentSuccess = pcall(function()
		serverEndpoint:InvokeServer("SyncMove", {{Model = groupModel, CFrame = groupModel:GetPivot(), Parent = destObj}})
	end)
	
	if not reparentSuccess then
		warn("⚠️ Failed to reparent group!")
		return false
	end
	
	print("✅ Reparented to:", destObj:GetFullName())
	task.wait(0.05)
	
	-- Step 4: Ungroup to steal ownership
	print("📤 Ungrouping to claim ownership...")
	local ungroupSuccess = pcall(function()
		serverEndpoint:InvokeServer("Ungroup", {sourceObj})
	end)
	
	if not ungroupSuccess then
		warn("⚠️ Failed to ungroup!")
		return false
	end
	
	print("✅ Ungrouped - waiting for RRPartOwner...")
	
	-- Wait for ownership claim
	for i = 1, 50 do
		if sourceObj:FindFirstChild("RRPartOwner") then
			print("✅ RRPartOwner added - Ownership claimed!")
			break
		end
		task.wait(0.01)
	end
	
	-- Step 5: Remove dummy part
	print("🗑️ Cleaning up dummy part...")
	pcall(function()
		if dummyPart and dummyPart.Parent then
			serverEndpoint:InvokeServer("Remove", {dummyPart})
			print("✅ Dummy part removed")
		end
	end)
	
	print("🎉 CUT complete!")
	return true
end

-- COPY function: Copy object using ungroup mechanic
local function performMoverCopy(sourceObj, destObj)
	print("📋 COPY: Copying", sourceObj:GetFullName(), "to", destObj:GetFullName())
	
	-- Get Building Tools
	local buildingTools = player.Backpack:FindFirstChild("Building Tools") or player.Backpack:FindFirstChild("Building Tools Plus")
	if not buildingTools and chr then
		buildingTools = chr:FindFirstChild("Building Tools") or chr:FindFirstChild("Building Tools Plus")
	end
	
	if not buildingTools then
		warn("⚠️ Building Tools not found!")
		return false
	end
	
	local syncAPI = buildingTools:FindFirstChild("SyncAPI")
	if not syncAPI then
		warn("⚠️ SyncAPI not found!")
		return false
	end
	
	local serverEndpoint = syncAPI:FindFirstChild("ServerEndpoint")
	if not serverEndpoint then
		warn("⚠️ ServerEndpoint not found!")
		return false
	end
	
	-- Step 1: Create dummy part
	print("🔨 Creating dummy part...")
	local dummyPart
	local createSuccess = pcall(function()
		dummyPart = serverEndpoint:InvokeServer("CreatePart", "Normal", CFrame.new(0, 900000000000000000000, 0), workspace)
	end)
	
	if not createSuccess or not dummyPart then
		warn("⚠️ Failed to create dummy part!")
		return false
	end
	
	print("✅ Created dummy part:", dummyPart:GetFullName())
	task.wait(0.05)
	
	-- Step 2: Group dummy with source object
	print("📦 Grouping dummy with source...")
	local groupSuccess, groupModel = pcall(function()
		return serverEndpoint:InvokeServer("CreateGroup", "Model", workspace, {dummyPart, sourceObj})
	end)
	
	if not groupSuccess or not groupModel then
		warn("⚠️ Failed to group parts!")
		pcall(function() serverEndpoint:InvokeServer("Remove", {dummyPart}) end)
		return false
	end
	
	print("✅ Grouped - Model:", groupModel:GetFullName())
	task.wait(0.05)
	
	-- Step 3: Clone the group
	print("📋 Cloning group...")
	local clonedGroup = groupModel:Clone()
	if not clonedGroup then
		warn("⚠️ Failed to clone group!")
		pcall(function() serverEndpoint:InvokeServer("Ungroup", {sourceObj}) end)
		pcall(function() serverEndpoint:InvokeServer("Remove", {dummyPart}) end)
		return false
	end
	
	print("✅ Cloned group")
	
	-- Step 4: Ungroup original to restore it
	print("📤 Ungrouping original to restore...")
	pcall(function()
		serverEndpoint:InvokeServer("Ungroup", {sourceObj})
	end)
	task.wait(0.05)
	
	-- Step 5: Remove original dummy
	pcall(function()
		if dummyPart and dummyPart.Parent then
			serverEndpoint:InvokeServer("Remove", {dummyPart})
		end
	end)
	
	-- Step 6: Parent cloned group to destination
	print("📍 Parenting clone to destination...")
	clonedGroup.Parent = destObj
	task.wait(0.05)
	
	-- Step 7: Find cloned source object and dummy in cloned group
	local clonedSource = clonedGroup:FindFirstChild(sourceObj.Name)
	local clonedDummy = nil
	for _, child in ipairs(clonedGroup:GetChildren()) do
		if child:IsA("BasePart") and child ~= clonedSource then
			clonedDummy = child
			break
		end
	end
	
	-- Step 8: Ungroup clone using F3X (to steal ownership of copy)
	print("📤 Ungrouping clone to claim ownership...")
	if clonedSource then
		local ungroupSuccess = pcall(function()
			serverEndpoint:InvokeServer("Ungroup", {clonedSource})
		end)
		
		if ungroupSuccess then
			print("✅ Clone ungrouped")
			
			-- Wait for ownership claim
			for i = 1, 50 do
				if clonedSource:FindFirstChild("RRPartOwner") then
					print("✅ RRPartOwner added to clone - Ownership claimed!")
					break
				end
				task.wait(0.01)
			end
		end
	end
	
	-- Step 9: Remove cloned dummy
	print("🗑️ Cleaning up cloned dummy...")
	if clonedDummy then
		pcall(function()
			serverEndpoint:InvokeServer("Remove", {clonedDummy})
			print("✅ Cloned dummy removed")
		end)
	end
	
	-- Step 10: Remove empty cloned group model
	task.wait(0.1)
	if clonedGroup and clonedGroup.Parent and #clonedGroup:GetChildren() == 0 then
		clonedGroup:Destroy()
		print("✅ Empty group model removed")
	end
	
	print("🎉 COPY complete!")
	return true
end

