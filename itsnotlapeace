-- Global physics panel state (prevents duplicate connections)
local activePhysicsConnection = nil
local activeSelectionBoxes = {}
local activeSelectedParts = {}

-- Physics Panel Creation Function (defined after contentFrame exists)
local function createPhysicsPanel()
	-- Cleanup any existing physics panel connections FIRST
	if activePhysicsConnection then
		warn("⚠️ Disconnecting existing physics connection")
		activePhysicsConnection:Disconnect()
		activePhysicsConnection = nil
	end
	
	-- DON'T clear selection boxes or parts - keep them persistent
	-- Only clear if they're invalid
	for part, box in pairs(activeSelectionBoxes) do
		if not part or not part.Parent or not box or not box.Parent then
			pcall(function()
				if box and box.Parent then
					box:Destroy()
				end
			end)
			activeSelectionBoxes[part] = nil
		end
	end
	
	-- Remove invalid parts from selection
	for i = #activeSelectedParts, 1, -1 do
		if not activeSelectedParts[i] or not activeSelectedParts[i].Parent then
			table.remove(activeSelectedParts, i)
		end
	end
	
	print("🔧 Creating physics panel. Current selection:", #activeSelectedParts, "parts")
	
	-- Check if physics panel already exists and destroy it
	local existingPanel = contentFrame:FindFirstChild("PhysicsScrollFrame")
	if existingPanel then
		existingPanel:Destroy()
	end
	
	-- Hide existing contentFrame children instead of destroying them
	for _, child in ipairs(contentFrame:GetChildren()) do
		child.Visible = false
	end
	
	-- Create scrolling frame for physics controls
	local physicsScrollFrame = Instance.new("ScrollingFrame")
	physicsScrollFrame.Name = "PhysicsScrollFrame"
	physicsScrollFrame.Size = UDim2.new(1, 0, 1, 0)
	physicsScrollFrame.Position = UDim2.new(0, 0, 0, 0)
	physicsScrollFrame.BackgroundTransparency = 1
	physicsScrollFrame.BorderSizePixel = 0
	physicsScrollFrame.ScrollBarThickness = 6
	physicsScrollFrame.ScrollBarImageColor3 = Color3.fromRGB(120, 180, 230)
	physicsScrollFrame.CanvasSize = UDim2.new(0, 0, 0, 600)
	physicsScrollFrame.ZIndex = 101
	physicsScrollFrame.Parent = contentFrame
	
	-- Auto-adjust canvas size and position sections in 3-column grid
	local columnWidth = 215
	local columnPadding = 10
	local rowPadding = 10
	local columnHeights = {0, 0, 0} -- Track height of each column
	
	local function updateCanvasSize()
		local sections = {}
		
		-- Collect all Frame sections
		for _, child in ipairs(physicsScrollFrame:GetChildren()) do
			if child:IsA("Frame") then
				table.insert(sections, child)
			end
		end
		
		if #sections == 0 then
			physicsScrollFrame.CanvasSize = UDim2.new(0, 0, 0, 20)
			return
		end
		
		-- Sort by LayoutOrder
		table.sort(sections, function(a, b)
			return (a.LayoutOrder or 0) < (b.LayoutOrder or 0)
		end)
		
		-- Reset column heights
		columnHeights = {0, 0, 0}
		
		-- Position each section in the shortest column
		for _, section in ipairs(sections) do
			-- Find shortest column
			local shortestCol = 1
			for col = 2, 3 do
				if columnHeights[col] < columnHeights[shortestCol] then
					shortestCol = col
				end
			end
			
			-- Position section
			local xPos = (shortestCol - 1) * (columnWidth + columnPadding)
			local yPos = columnHeights[shortestCol]
			
			section.Position = UDim2.new(0, xPos, 0, yPos)
			section.Size = UDim2.new(0, columnWidth, 0, section.Size.Y.Offset)
			
			-- Update column height
			columnHeights[shortestCol] = columnHeights[shortestCol] + section.Size.Y.Offset + rowPadding
