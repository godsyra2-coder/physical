-- Destroy function using F3XPartModificationLimit exploit
local function destroyObject(object)
	if not F3XLimit or not EscalateEvent then
		warn("[ERROR] F3X exploit not initialized - cannot destroy objects")
		return false
	end
	
	print("[EXPLOIT] Using F3XPartModificationLimit.escalatedEvent")
	print("[TARGET]", object:GetFullName())
	
	local success, err = pcall(function()
		EscalateEvent:FireServer(F3XLimit, object)
	end)
	
	if success then
		print("[FIRED] EscalateEvent with F3XPartModificationLimit")
		wait(0.5)
		
		-- Check if destroyed
		local stillExists = pcall(function() return object.Parent end)
