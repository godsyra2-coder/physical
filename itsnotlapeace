	-- Apply Time Scale callback
	applyTimeScaleButton.MouseButton1Click:Connect(function()
		local scale = tonumber(timeScaleInput.Text) or 1
		scale = math.clamp(scale, 0.01, 10) -- Clamp between 0.01 and 10
		
		if timeScaleActive and scale == 1 then
			-- Disable time scale
			timeScaleActive = false
			currentTimeScale = 1
			if timeScaleConnection then
				timeScaleConnection:Disconnect()
				timeScaleConnection = nil
			end
			print("⏱️ Disabled time scale")
		else
			-- Enable time scale
			timeScaleActive = true
			currentTimeScale = scale
			
			-- Disconnect old connection if exists
			if timeScaleConnection then
				timeScaleConnection:Disconnect()
			end
			
			-- Create new connection
			timeScaleConnection = RunService.Heartbeat:Connect(function()
				if timeScaleActive then
					for _, part in ipairs(workspace:GetDescendants()) do
						if part:IsA("BasePart") and not part.Anchored then
							pcall(function()
								local vel = part.AssemblyLinearVelocity
								part.AssemblyLinearVelocity = vel * currentTimeScale
							end)
						end
					end
				end
			end)
			
			print("⏱️ Applied time scale:", scale, scale < 1 and "(SLOW MOTION)" or scale > 1 and "(FAST FORWARD)" or "(NORMAL)")
		end
	end)
	
