	-- Helper function to get ServerEndpoint
	local function getServerEndpoint()
		local buildingTools = getBuildingTools()
		if not buildingTools then return nil end
		local syncAPI = buildingTools:FindFirstChild("SyncAPI")
		if not syncAPI then return nil end
		return syncAPI:FindFirstChild("ServerEndpoint")
