	-- Steal function
	local function stealPart(part)
		if not part or not part.Parent then return false end
		
		local serverEndpoint = getServerEndpoint()
		if not serverEndpoint then 
			warn("⚠️ Building Tools not found!")
			return false 
		end
		
		local success = false
		pcall(function()
			-- Step 1: Claim ownership using F3X exploit
			local EscalateEvent = RS.raidRoleplay.Events.EscalateEvent
			local PartOwnership = RS.raidRoleplay.Modules.PartOwnership
			EscalateEvent:FireServer(PartOwnership, {part})
			
			task.wait(0.05)
			
			-- Step 2: Create a union with the part
			local union = serverEndpoint:InvokeServer("CreateUnion", {part})
			
			if union then
				task.wait(0.03)
				
				-- Step 3: Separate union - this gives us ownership
				serverEndpoint:InvokeServer("SeparateUnion", {union})
				
				-- Step 4: Unlock the part locally
				task.wait(0.1)
				pcall(function()
					part.Locked = false
				end)
				
				success = true
			end
		end)
		
		return success
	end
	
	local success = stealPart(state.targetObject)
	
	if success then
