						if isKeybind then
							local connection = RunService.Heartbeat:Connect(function()
								if not part.Parent then
									if connection then connection:Disconnect() end
									if torqueConstraint then torqueConstraint:Destroy() end
									if attachment then attachment:Destroy() end
									return
								end
								torqueConstraint.Torque = isKeyDown and (angularVel * torque) or Vector3.new(0, 0, 0)
							end)
							
							table.insert(angularControls[part].controls, {
								torqueForce = torqueConstraint,
								attachment = attachment,
								connection = connection,
								keybindConnection = keybindConnection
							})
						else
							table.insert(angularControls[part].controls, {
								torqueForce = torqueConstraint,
								attachment = attachment,
								keybindConnection = keybindConnection
							})
						end
					end
					
					print("Applied angular velocity to " .. part.Name .. " using " .. angType)
				end)
			end
		end
	end)
	
	-- Stop Angular button (NEW)
	stopAngularButton.MouseButton1Click:Connect(function()
		for _, part in ipairs(activeSelectedParts) do
			if part and part.Parent then
				pcall(function()
					-- Clean up angular controls
					if angularControls[part] and angularControls[part].controls then
						for _, control in ipairs(angularControls[part].controls) do
							if control.connection then control.connection:Disconnect() end
							if control.keybindConnection then control.keybindConnection:Disconnect() end
							if control.bodyAngVel then control.bodyAngVel:Destroy() end
							if control.bodyPosition then control.bodyPosition:Destroy() end
							if control.bodyGyro then control.bodyGyro:Destroy() end
							if control.attachment then control.attachment:Destroy() end
							if control.torqueForce then control.torqueForce:Destroy() end
							if control.angularVelocityConstraint then control.angularVelocityConstraint:Destroy() end
						end
						angularControls[part] = nil
					end
					
					-- Stop angular velocity
					part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
				end)
			end
		end
		print("Stopped angular velocity for selected parts")
	end)
	
	-- Remove Angular Keybinds Button Callback (NEW)
	removeKeybindsButton.MouseButton1Click:Connect(function()
		local totalRemoved = 0
		
		-- Clean up ONLY angular controls
		for part, data in pairs(angularControls) do
			if data.controls then
				pcall(function()
					for _, control in ipairs(data.controls) do
						if control.keybindConnection then 
							control.keybindConnection:Disconnect()
							totalRemoved = totalRemoved + 1
						end
						if control.connection then control.connection:Disconnect() end
						if control.bodyAngVel then control.bodyAngVel:Destroy() end
						if control.bodyPosition then control.bodyPosition:Destroy() end
						if control.bodyGyro then control.bodyGyro:Destroy() end
						if control.attachment then control.attachment:Destroy() end
						if control.torqueForce then control.torqueForce:Destroy() end
						if control.angularVelocityConstraint then control.angularVelocityConstraint:Destroy() end
					end
				end)
			end
		end
		angularControls = {}
		
		print("🗑️ Removed all angular keybinds! Total:", totalRemoved, "keybinds")
	end)
	
	print("Physics Panel loaded successfully")
end

