	-- Helper function to find nearest face
	local function getNearestFace(part1, part2)
		local direction = (part2.Position - part1.Position).Unit
		local faces = {
			{normal = Vector3.new(1, 0, 0), name = "Right"},
			{normal = Vector3.new(-1, 0, 0), name = "Left"},
			{normal = Vector3.new(0, 1, 0), name = "Top"},
			{normal = Vector3.new(0, -1, 0), name = "Bottom"},
			{normal = Vector3.new(0, 0, 1), name = "Front"},
			{normal = Vector3.new(0, 0, -1), name = "Back"}
		}
		
		local bestFace = faces[1]
		local bestDot = -math.huge
		
		for _, face in ipairs(faces) do
			local worldNormal = part1.CFrame:VectorToWorldSpace(face.normal)
			local dot = worldNormal:Dot(direction)
			if dot > bestDot then
				bestDot = dot
				bestFace = face
			end
		end
		
		return bestFace.normal
	end
	
