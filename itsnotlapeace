	applyDestabilizerButton.MouseButton1Click:Connect(function()
		if #activeSelectedParts == 0 then
			warn("⚠️ Select at least 1 part to destabilize!")
			return
		end
		
		local mode = destabilizerModeDropdown.Text:gsub(" ▼", "")
		local intensity = math.clamp(tonumber(destabilizerIntensityInput.Text) or 10, 1, 50)
		
		for _, part in ipairs(activeSelectedParts) do
			if part and part.Parent then
				replicateToServer(function()
					setNetworkOwnership(part)
					
					-- Remove old destabilizer if exists
					if unstabilizedParts[part] then
						if unstabilizedParts[part].connection then unstabilizedParts[part].connection:Disconnect() end
						if unstabilizedParts[part].bodyGyro then unstabilizedParts[part].bodyGyro:Destroy() end
					end
					
					-- Create BodyGyro for rotation control
					local bodyGyro = Instance.new("BodyGyro")
					bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
					bodyGyro.D = 100
					bodyGyro.P = 5000
					bodyGyro.Parent = part
					
					local time = 0
					
					-- Create chaos loop
					local connection = RunService.RenderStepped:Connect(function(dt)
						if not part.Parent then
							connection:Disconnect()
							return
						end
						
						time = time + dt
						
						local targetCFrame
						
						if mode == "Chaotic" then
							-- Random rotation every frame
							targetCFrame = CFrame.Angles(
								math.random() * math.pi * 2,
								math.random() * math.pi * 2,
								math.random() * math.pi * 2
							)
							
						elseif mode == "Glitchy" then
							-- Snaps between random angles rapidly
							if math.random() > 0.7 then
								targetCFrame = CFrame.Angles(
									math.random(0, 3) * (math.pi/2),
									math.random(0, 3) * (math.pi/2),
									math.random(0, 3) * (math.pi/2)
								)
							else
								targetCFrame = bodyGyro.CFrame
							end
							
						elseif mode == "Seizure" then
							-- Extremely fast random rotation
							targetCFrame = CFrame.Angles(
								math.sin(time * 100 * intensity) * math.pi,
								math.cos(time * 100 * intensity) * math.pi,
								math.sin(time * 50 * intensity) * math.pi
							)
							
						elseif mode == "Vibrate" then
							-- Small jittery movements
							local jitter = 0.1 * intensity
							targetCFrame = bodyGyro.CFrame * CFrame.Angles(
								(math.random() - 0.5) * jitter,
								(math.random() - 0.5) * jitter,
								(math.random() - 0.5) * jitter
							)
							
						elseif mode == "Spinning Chaos" then
							-- Spins wildly in all directions
							targetCFrame = CFrame.Angles(
								time * intensity * 5,
								time * intensity * 3,
								time * intensity * 7
							) * CFrame.Angles(
								math.sin(time * 10) * 0.5,
								math.cos(time * 15) * 0.5,
								math.sin(time * 8) * 0.5
							)
						end
						
						bodyGyro.CFrame = CFrame.new(part.Position) * targetCFrame
						
						-- Force angular velocity for extra chaos
						if mode == "Chaotic" or mode == "Seizure" then
							part.AssemblyAngularVelocity = Vector3.new(
								(math.random() - 0.5) * intensity * 10,
								(math.random() - 0.5) * intensity * 10,
								(math.random() - 0.5) * intensity * 10
							)
						end
					end)
					
					unstabilizedParts[part] = {
						bodyGyro = bodyGyro,
						connection = connection,
						intensity = intensity,
						mode = mode
					}
					
					print("⚠️ Applied Destabilizer (" .. mode .. ", intensity: " .. intensity .. ") to " .. part.Name)
				end)
			end
		end
		
		print("⚠️ Destabilized", #activeSelectedParts, "parts with mode:", mode)
	end)
	
