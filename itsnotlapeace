-- Global debounce cache for performance
local debounceCache = {}
local function debounce(key, func, delay)
	delay = delay or 0.05
	local lastCall = debounceCache[key] or 0
	local now = tick()
	if now - lastCall >= delay then
		debounceCache[key] = now
		return func()
	end
end

