local function removeEverythingScripts()
	removeESLabel.Text = "🔍 SCANNING..."
	removeEverythingScriptsButton.BackgroundColor3 = Color3.fromRGB(200, 140, 80)
	
	-- Find Workspace/Terrain/Everything
	local terrain = workspace:FindFirstChild("Terrain")
	if not terrain then
		removeESLabel.Text = "❌ TERRAIN NOT FOUND"
		removeEverythingScriptsButton.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
		wait(2)
		removeESLabel.Text = "🗑️ REMOVE EVERYTHING SCRIPTS"
		removeEverythingScriptsButton.BackgroundColor3 = Color3.fromRGB(220, 60, 70)
		return
	end
	
	local everything = terrain:FindFirstChild("Everything")
	if not everything then
		removeESLabel.Text = "❌ EVERYTHING NOT FOUND"
		removeEverythingScriptsButton.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
		wait(2)
		removeESLabel.Text = "🗑️ REMOVE EVERYTHING SCRIPTS"
		removeEverythingScriptsButton.BackgroundColor3 = Color3.fromRGB(220, 60, 70)
		return
	end
	
	task.spawn(function()
		-- Collect all scripts under Everything
		local allScripts = {}
		for _, descendant in ipairs(everything:GetDescendants()) do
			if descendant:IsA("BaseScript") or descendant:IsA("LocalScript") or descendant:IsA("Script") or descendant:IsA("ModuleScript") then
				table.insert(allScripts, descendant)
			end
		end
		
		local totalScripts = #allScripts
		if totalScripts == 0 then
			removeESLabel.Text = "⚠️ NO SCRIPTS FOUND"
			removeEverythingScriptsButton.BackgroundColor3 = Color3.fromRGB(150, 150, 50)
			wait(2)
			removeESLabel.Text = "🗑️ REMOVE EVERYTHING SCRIPTS"
			removeEverythingScriptsButton.BackgroundColor3 = Color3.fromRGB(220, 60, 70)
			return
		end
		
		removeESLabel.Text = string.format("🗑️ REMOVING %d SCRIPTS...", totalScripts)
		print(string.format("🚀 Found %d scripts - firing all destroy operations in parallel", totalScripts))
		
		-- Split into batches of 20 scripts
		local batchSize = 20
		local batches = {}
		for i = 1, totalScripts, batchSize do
			local batch = {}
			for j = i, math.min(i + batchSize - 1, totalScripts) do
				table.insert(batch, allScripts[j])
			end
			table.insert(batches, batch)
		end
		
		local totalBatches = #batches
		local destroyedCount = 0
		
		-- Fire ALL batches at the same time (parallel processing)
		for batchIndex, batch in ipairs(batches) do
			task.spawn(function()
				for _, script in ipairs(batch) do
					if script and script.Parent then
						local success = pcall(function()
							destroyObject(script)
						end)
						if success then
							destroyedCount = destroyedCount + 1
						end
					end
				end
				
				-- Update progress every 5 batches
				if batchIndex % 5 == 0 or batchIndex == totalBatches then
					removeESLabel.Text = string.format("🗑️ REMOVED: %d/%d", destroyedCount, totalScripts)
				end
			end)
		end
		
		-- Wait for all batches to complete (estimate)
		task.wait(math.max(0.5, totalBatches * 0.1))
		
		-- Final update
		if destroyedCount > 0 then
			removeESLabel.Text = string.format("✅ REMOVED %d SCRIPTS", destroyedCount)
			removeEverythingScriptsButton.BackgroundColor3 = Color3.fromRGB(80, 200, 120)
			print(string.format("✅ Successfully removed %d scripts from Workspace/Terrain/Everything", destroyedCount))
		else
			removeESLabel.Text = "❌ REMOVAL FAILED"
			removeEverythingScriptsButton.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
		end
		
		wait(2)
		removeESLabel.Text = "🗑️ REMOVE EVERYTHING SCRIPTS"
		removeEverythingScriptsButton.BackgroundColor3 = Color3.fromRGB(220, 60, 70)
	end)
end

-- Make frame draggable (wrapped in function to reduce top-level locals)
local function setupDragging()
	local dragging = false
	local dragInput, mousePos, framePos

	titleBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			mousePos = input.Position
			framePos = mainFrame.Position
			
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	titleBar.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - mousePos
			mainFrame.Position = UDim2.new(
				framePos.X.Scale,
				framePos.X.Offset + delta.X,
				framePos.Y.Scale,
				framePos.Y.Offset + delta.Y
			)
		end
	end)
end

setupDragging()

